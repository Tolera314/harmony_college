generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                    @id @default(uuid())
  fullName             String
  email                String?                   @unique
  phone                String?                   @unique
  /// bcrypt hash of the user's password. Optional for OAuth-only users. NEVER store plaintext.
  passwordHash         String?
  role                 Role                      @default(STUDENT)
  status               AccountStatus             @default(PENDING_VERIFICATION)
  emailVerified        Boolean                   @default(false)
  phoneVerified        Boolean                   @default(false)
  profileCompleted     Boolean                   @default(false)
  profileCompletion    Int                       @default(0)
  failedLoginAttempts  Int                       @default(0)
  lastLoginAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  application          Application?
  auditLogs            AuditLog[]
  conversations        ConversationParticipant[]
  dhAuditLogs          DepartmentHeadAuditLog[]
  departmentHeadRecord DepartmentHeadRecord?
  hrEmployee           HREmployee?
  instructorRecord     InstructorRecord?
  messages             Message[]
  oauthAccounts        OAuthAccount[]
  passwordResetTokens  PasswordResetToken[]
  registrarLogs        RegistrarAuditLog[]
  sessions             Session[]
  acceptedInvitation   StaffInvitation?          @relation("AcceptedInvitation")
  sentInvitations      StaffInvitation[]         @relation("SentInvitations")
  studentProfile       StudentProfile?
  studentRecord        StudentRecord?
  verificationTokens   VerificationToken[]

  @@index([role])
  @@index([status])
  @@index([email])
  @@index([phone])
}

/// Federated OAuth identity linked to a User account.
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// An authenticated session tied to a specific device/browser.
/// One user can have many sessions (multi-device).
/// Deleting a session immediately invalidates the corresponding refresh token.
model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  deviceInfo       String?  @db.VarChar(255)
  ipAddress        String?  @db.VarChar(45)
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  lastUsedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  type      VerificationTokenType
  tokenHash String
  attempts  Int                   @default(0)
  used      Boolean               @default(false)
  expiresAt DateTime
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  attempts  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  metadata  Json?
  ipAddress String?     @db.VarChar(45)
  userAgent String?     @db.VarChar(255)
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model StudentProfile {
  id                       String      @id @default(uuid())
  userId                   String      @unique
  dob                      DateTime?
  gender                   String?
  nationality              String?
  region                   String?
  city                     String?
  address                  String?
  program                  String?
  academicYear             String?
  semester                 String?
  matricResult             String?
  ministryResult           String?
  profilePictureUrl        String?
  faydaIdUrl               String?
  transcriptUrl            String?
  emergencyName            String?
  emergencyRelationship    String?
  emergencyPhone           String?
  emergencyNotes           String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  /// Department chosen on the /onboarding/about page (pre-enrollment preference).
  selectedDepartmentId     String?
  /// Set to true once the student picks a department on /onboarding/about.
  departmentSelected       Boolean     @default(false)
  /// Set to true once the student confirms registration fee payment on /onboarding/about.
  registrationFeePaid      Boolean     @default(false)
  registrationFeePaidAt    DateTime?
  paymentVerifiedAt        DateTime?
  /// Set to true once a Finance Officer verifies the student's registration fee payment.
  paymentVerifiedByFinance Boolean     @default(false)
  paymentVerifiedByUserId  String?
  nationalId               String?
  programType              String?
  shortProgramDuration     String?
  selectedDepartment       Department? @relation(fields: [selectedDepartmentId], references: [id])
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id                        String            @id @default(uuid())
  userId                    String            @unique
  fullName                  String
  dob                       DateTime
  age                       Int
  gender                    String
  nationality               String
  emergencyContact          String
  phone                     String
  city                      String
  address                   String
  program                   String
  academicYear              String
  semester                  String
  studyMode                 String
  submittedAt               DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  reviewComment             String?
  reviewedAt                DateTime?
  reviewedBy                String?
  status                    ApplicationStatus @default(DRAFT)
  onboardingRejectionReason String?
  onboardingReviewedAt      DateTime?
  onboardingReviewedBy      String?
  onboardingStatus          OnboardingStatus  @default(PENDING)
  registrationScreenshotUrl String?
  screenshotUploadedAt      DateTime?
  programType               String?
  shortProgramDuration      String?
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents                 Document[]

  @@index([status])
  @@index([program])
  @@index([academicYear])
}

model Document {
  id            String      @id @default(uuid())
  applicationId String
  type          String
  fileUrl       String
  uploadedAt    DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String                    @id @default(uuid())
  name          String?
  createdAt     DateTime                  @default(now())
  createdById   String?
  departmentId  String?
  description   String?
  expiresAt     DateTime?
  isActive      Boolean                   @default(true)
  lastMessageAt DateTime?
  priority      MessagePriority           @default(NORMAL)
  requiresAck   Boolean                   @default(false)
  type          ConversationType          @default(DIRECT)
  updatedAt     DateTime                  @updatedAt
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([type])
  @@index([departmentId])
  @@index([lastMessageAt])
  @@index([isActive])
}

model ConversationParticipant {
  conversationId    String
  userId            String
  lastReadAt        DateTime?
  isArchived        Boolean      @default(false)
  isMuted           Boolean      @default(false)
  isPinned          Boolean      @default(false)
  joinedAt          DateTime     @default(now())
  lastReadMessageId String?
  leftAt            DateTime?
  participantRole   String       @default("MEMBER")
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@index([userId, isArchived])
}

model Message {
  id             String              @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime            @default(now())
  deletedAt      DateTime?
  deletedById    String?
  editedAt       DateTime?
  editedById     String?
  isDeleted      Boolean             @default(false)
  messageType    String              @default("TEXT")
  replyToId      String?
  status         MessageStatus       @default(SENT)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?            @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]           @relation("MessageReplies")
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, isDeleted])
}

model MessageAttachment {
  id               String   @id @default(uuid())
  messageId        String
  originalFileName String
  storedFileName   String
  mimeType         String
  fileSize         Int
  storagePath      String
  uploadedAt       DateTime @default(now())
  message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageAcknowledgment {
  id             String   @id @default(uuid())
  messageId      String
  userId         String
  acknowledgedAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model Department {
  id                 String                 @id @default(uuid())
  name               String
  code               String
  description        String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  programType        ProgramType            @default(TVET)
  parentId           String?
  courses            Course[]
  parent             Department?            @relation("DeptChildren", fields: [parentId], references: [id])
  children           Department[]           @relation("DeptChildren")
  departmentHeads    DepartmentHeadRecord[]
  instructors        InstructorRecord[]
  programs           Program[]
  staffInvitations   StaffInvitation[]
  onboardingStudents StudentProfile[]
  studentRecords     StudentRecord[]
  tuitionConfigs     TuitionConfiguration[]

  @@unique([name, programType])
  @@unique([code, programType])
  @@index([programType])
  @@index([code])
  @@index([isActive])
  @@index([parentId])
}

model Program {
  id             String                 @id @default(uuid())
  name           String
  code           String                 @unique
  description    String?
  durationYears  Int                    @default(4)
  totalCredits   Int                    @default(120)
  isActive       Boolean                @default(true)
  departmentId   String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  department     Department             @relation(fields: [departmentId], references: [id])
  courses        ProgramCourse[]
  requirements   ProgramRequirement[]
  studentRecords StudentRecord[]
  tuitionConfigs TuitionConfiguration[]

  @@index([departmentId])
  @@index([isActive])
}

model AcademicYear {
  id             String                  @id @default(uuid())
  name           String                  @unique
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean                 @default(false)
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  calendarEvents AcademicCalendarEvent[]
  semesters      Semester[]

  @@index([isCurrent])
}

model Semester {
  id                String           @id @default(uuid())
  name              String
  academicYearId    String
  startDate         DateTime
  endDate           DateTime
  registrationStart DateTime
  registrationEnd   DateTime
  addDropDeadline   DateTime
  isCurrent         Boolean          @default(false)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  programType       ProgramType      @default(TVET)
  offerings         CourseOffering[]
  academicYear      AcademicYear     @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, name, programType])
  @@index([programType])
  @@index([isCurrent])
}

model Course {
  id             String               @id @default(uuid())
  code           String
  name           String
  description    String?
  creditHours    Int                  @default(3)
  status         CourseStatus         @default(ACTIVE)
  departmentId   String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  programType    ProgramType          @default(TVET)
  ects           Int                  @default(4)
  department     Department           @relation(fields: [departmentId], references: [id])
  offerings      CourseOffering[]
  prerequisites  CoursePrerequisite[] @relation("CoursePrereqs")
  requiredBy     CoursePrerequisite[] @relation("PrereqFor")
  programCourses ProgramCourse[]

  @@unique([code, programType])
  @@index([programType])
  @@index([code])
  @@index([departmentId])
  @@index([status])
}

model CoursePrerequisite {
  id             String @id @default(uuid())
  courseId       String
  prerequisiteId String
  course         Course @relation("CoursePrereqs", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite   Course @relation("PrereqFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteId])
  @@index([courseId])
}

model ProgramCourse {
  id         String  @id @default(uuid())
  programId  String
  courseId   String
  isRequired Boolean @default(true)
  yearLevel  Int     @default(1)
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, courseId])
}

model ProgramRequirement {
  id              String  @id @default(uuid())
  programId       String
  category        String
  description     String?
  requiredCredits Int
  minimumGPA      Float   @default(2.0)
  program         Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model Room {
  id            String           @id @default(uuid())
  name          String
  building      String
  capacity      Int
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  roomType      RoomType         @default(CLASSROOM)
  classSessions ClassSession[]
  offerings     CourseOffering[]
  timetables    TimetableSlot[]

  @@unique([building, name])
  @@index([building])
  @@index([isActive])
  @@index([roomType])
}

model InstructorRecord {
  id             String                   @id @default(uuid())
  userId         String                   @unique
  employeeId     String                   @unique
  title          String                   @default("Instructor")
  specialization String?
  isActive       Boolean                  @default(true)
  departmentId   String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  offerings      CourseOffering[]
  leaveRequests  DepartmentLeaveRequest[]
  department     Department               @relation(fields: [departmentId], references: [id])
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetables     TimetableSlot[]

  @@index([departmentId])
  @@index([isActive])
}

model StudentRecord {
  id                     String                         @id @default(uuid())
  userId                 String                         @unique
  studentId              String                         @unique
  status                 StudentStatus                  @default(ACTIVE)
  programId              String
  departmentId           String
  yearLevel              Int                            @default(1)
  gpa                    Float                          @default(0.0)
  totalCredits           Int                            @default(0)
  admittedAt             DateTime                       @default(now())
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  programType            ProgramType                    @default(TVET)
  shortProgramDuration   String?
  advisorAppointments    AdvisorAppointment[]
  assignmentSubmissions  AssignmentSubmission[]
  attendanceRecords      AttendanceRecord[]
  certificate            Certificate?
  courseGrades           CourseGrade[]
  enrollments            Enrollment[]
  financialAccount       FinancialAccount?
  graduationAudit        GraduationAudit?
  monthlyInstallments    MonthlyInstallment[]
  paymentReceipts        PaymentReceipt[]
  paymentSubmissions     PaymentSubmission[]
  quizAttempts           QuizAttempt[]
  notificationPreference StudentNotificationPreference?
  department             Department                     @relation(fields: [departmentId], references: [id])
  program                Program                        @relation(fields: [programId], references: [id])
  user                   User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcriptRequests     TranscriptRequest[]

  @@index([programType])
  @@index([studentId])
  @@index([programId])
  @@index([departmentId])
  @@index([status])
}

model CourseOffering {
  id                   String            @id @default(uuid())
  courseId             String
  semesterId           String
  status               OfferingStatus    @default(DRAFT)
  instructorId         String?
  roomId               String?
  capacity             Int               @default(40)
  section              String            @default("A")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  programType          ProgramType       @default(TVET)
  shortProgramDuration String?
  assignments          Assignment[]
  classSessions        ClassSession[]
  course               Course            @relation(fields: [courseId], references: [id])
  instructor           InstructorRecord? @relation(fields: [instructorId], references: [id])
  room                 Room?             @relation(fields: [roomId], references: [id])
  semester             Semester          @relation(fields: [semesterId], references: [id])
  enrollments          Enrollment[]
  quizzes              Quiz[]
  timetables           TimetableSlot[]

  @@unique([courseId, semesterId, section])
  @@index([programType])
  @@index([semesterId])
  @@index([courseId])
  @@index([instructorId])
  @@index([status])
}

model TimetableSlot {
  id               String              @id @default(uuid())
  courseOfferingId String
  dayOfWeek        Int
  startTime        String
  endTime          String
  roomId           String?
  instructorId     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  status           TimetableSlotStatus @default(PUBLISHED)
  courseOffering   CourseOffering      @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  instructor       InstructorRecord?   @relation(fields: [instructorId], references: [id])
  room             Room?               @relation(fields: [roomId], references: [id])

  @@index([courseOfferingId])
  @@index([roomId])
  @@index([dayOfWeek])
  @@index([status])
}

model Enrollment {
  id               String           @id @default(uuid())
  studentRecordId  String
  courseOfferingId String
  status           EnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime         @default(now())
  droppedAt        DateTime?
  dropReason       String?
  isOverride       Boolean          @default(false)
  overrideReason   String?
  overrideBy       String?
  overrideAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  grade            CourseGrade?
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id])
  studentRecord    StudentRecord    @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  @@unique([studentRecordId, courseOfferingId])
  @@index([studentRecordId])
  @@index([courseOfferingId])
  @@index([status])
}

model CourseGrade {
  id              String        @id @default(uuid())
  enrollmentId    String        @unique
  studentRecordId String
  letterGrade     String?
  gradePoints     Float?
  creditHours     Int           @default(3)
  gradedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  assignmentMarks Float?
  attendanceMarks Float?
  ects            Int           @default(4)
  finalExamMarks  Float?
  finalMark       Float?
  midExamMarks    Float?
  otherMarks      Float?
  publishedAt     DateTime?
  qualityPoints   Float?
  quizMarks       Float?
  status          String        @default("DRAFT")
  submittedAt     DateTime?
  submittedBy     String?
  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id])

  @@index([studentRecordId])
  @@index([enrollmentId])
  @@index([status])
}

model TranscriptRequest {
  id              String                  @id @default(uuid())
  studentRecordId String
  status          TranscriptRequestStatus @default(PENDING)
  purpose         String?
  requestedAt     DateTime                @default(now())
  processedAt     DateTime?
  processedBy     String?
  rejectionReason String?
  issuedAt        DateTime?
  documentUrl     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  studentRecord   StudentRecord           @relation(fields: [studentRecordId], references: [id])

  @@index([studentRecordId])
  @@index([status])
}

model GraduationAudit {
  id               String           @id @default(uuid())
  studentRecordId  String           @unique
  status           GraduationStatus @default(PENDING)
  completedCredits Int              @default(0)
  requiredCredits  Int              @default(120)
  currentGpa       Float            @default(0.0)
  requiredGpa      Float            @default(2.0)
  isEligible       Boolean          @default(false)
  auditNotes       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  graduatedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  studentRecord    StudentRecord    @relation(fields: [studentRecordId], references: [id])

  @@index([status])
}

model Certificate {
  id                String            @id @default(uuid())
  studentRecordId   String            @unique
  status            CertificateStatus @default(ISSUED)
  certificateNumber String            @unique
  verificationCode  String            @unique
  issuedAt          DateTime          @default(now())
  issuedBy          String
  revokedAt         DateTime?
  revokedBy         String?
  revocationReason  String?
  documentUrl       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  studentRecord     StudentRecord     @relation(fields: [studentRecordId], references: [id])

  @@index([verificationCode])
  @@index([status])
}

model AcademicCalendarEvent {
  id             String            @id @default(uuid())
  title          String
  description    String?
  eventType      CalendarEventType
  startDate      DateTime
  endDate        DateTime
  isPublished    Boolean           @default(false)
  academicYearId String?
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  academicYear   AcademicYear?     @relation(fields: [academicYearId], references: [id])

  @@index([eventType])
  @@index([startDate])
  @@index([isPublished])
}

model Announcement {
  id             String             @id @default(uuid())
  title          String
  content        String
  status         AnnouncementStatus @default(DRAFT)
  priority       String             @default("NORMAL")
  targetAudience String             @default("ALL")
  publishDate    DateTime?
  expirationDate DateTime?
  createdBy      String
  publishedBy    String?
  publishedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
  @@index([publishDate])
}

model RegistrarAuditLog {
  id          String          @id @default(uuid())
  userId      String
  action      RegistrarAction
  entityType  String
  entityId    String
  description String
  metadata    Json?
  ipAddress   String?         @db.VarChar(45)
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  title      String
  message    String
  /// INFO | SUCCESS | WARNING | ERROR | GRADE | SCHEDULE | ENROLLMENT | ANNOUNCEMENT | LEAVE | PAYROLL | FINANCE | CONTRACT | ONBOARDING | PERFORMANCE
  type       String    @default("INFO")
  isRead     Boolean   @default(false)
  entityType String?
  entityId   String?
  createdAt  DateTime  @default(now())
  /// Optional deep-link tab name for the recipient's dashboard (e.g. "grades", "leave", "employees")
  actionTab  String?
  /// Module namespace — keeps notifications from different domains in one table.
  /// Values: ACADEMIC | HR | FINANCE | ADMIN | SYSTEM
  /// HR notifications carry module = "HR" so they can be filtered separately from academic notifications.
  module     String    @default("ACADEMIC")
  /// Timestamp when a socket push was attempted; null = not yet pushed
  pushedAt   DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([userId, module])
}

model GradeScale {
  id           String   @id @default(uuid())
  letterGrade  String   @unique
  gradePoints  Float
  description  String?
  isPassing    Boolean  @default(true)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([letterGrade])
}

model GradePortalSetting {
  id        String    @id @default("default")
  isOpen    Boolean   @default(false)
  openedAt  DateTime?
  openedBy  String?
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model GradeEditingSetting {
  id        String    @id @default("default")
  isOpen    Boolean   @default(true)
  openedAt  DateTime?
  openedBy  String?
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Assignment {
  id               String                 @id @default(uuid())
  courseOfferingId String
  createdBy        String
  title            String
  description      String
  instructions     String
  dueDate          DateTime
  totalPoints      Int                    @default(100)
  status           AssignmentStatus       @default(DRAFT)
  allowLateSubmit  Boolean                @default(false)
  maxFileSize      Int                    @default(250)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  courseOffering   CourseOffering         @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  attachments      AssignmentAttachment[]
  submissions      AssignmentSubmission[]

  @@index([courseOfferingId])
  @@index([dueDate])
  @@index([status])
}

model AssignmentAttachment {
  id           String     @id @default(uuid())
  assignmentId String
  fileName     String
  fileUrl      String
  fileSize     String
  fileType     String
  uploadedAt   DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model AssignmentSubmission {
  id              String           @id @default(uuid())
  assignmentId    String
  studentRecordId String
  status          SubmissionStatus @default(SUBMITTED)
  submittedAt     DateTime         @default(now())
  fileUrl         String?
  fileName        String?
  fileSize        String?
  textContent     String?
  score           Float?
  letterGrade     String?
  feedback        String?
  gradedAt        DateTime?
  gradedBy        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assignment      Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentRecord   StudentRecord    @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentRecordId])
  @@index([assignmentId])
  @@index([studentRecordId])
  @@index([status])
}

model Quiz {
  id                     String         @id @default(uuid())
  courseOfferingId       String
  createdBy              String
  title                  String
  description            String?
  instructions           String?
  durationMinutes        Int            @default(30)
  availableFrom          DateTime
  availableUntil         DateTime
  passingScore           Int            @default(60)
  maxAttempts            Int            @default(1)
  totalPoints            Int            @default(100)
  showResultsImmediately Boolean        @default(true)
  status                 QuizStatus     @default(DRAFT)
  shuffleQuestions       Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  courseOffering         CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  attempts               QuizAttempt[]
  questions              QuizQuestion[]

  @@index([courseOfferingId])
  @@index([status])
  @@index([availableFrom])
  @@index([availableUntil])
}

model QuizQuestion {
  id           String               @id @default(uuid())
  quizId       String
  questionText String
  type         QuestionType
  points       Int                  @default(1)
  orderIndex   Int                  @default(0)
  answers      QuizAnswer[]
  quiz         Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options      QuizQuestionOption[]

  @@index([quizId])
  @@index([orderIndex])
}

model QuizQuestionOption {
  id         String       @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  orderIndex Int          @default(0)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id               String            @id @default(uuid())
  quizId           String
  studentRecordId  String
  status           QuizAttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime          @default(now())
  submittedAt      DateTime?
  timeSpentSeconds Int?
  score            Float?
  percentageScore  Float?
  isPassing        Boolean?
  feedback         String?
  gradedAt         DateTime?
  gradedBy         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  answers          QuizAnswer[]
  quiz             Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentRecord    StudentRecord     @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([studentRecordId])
  @@index([status])
}

model QuizAnswer {
  id               String       @id @default(uuid())
  attemptId        String
  questionId       String
  answerText       String?
  selectedOptionId String?
  isCorrect        Boolean?
  pointsEarned     Float?
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

/// A specific physical class meeting derived from a TimetableSlot.
model ClassSession {
  id                String             @id @default(uuid())
  courseOfferingId  String
  date              DateTime
  startTime         String
  endTime           String
  topic             String?
  roomId            String?
  createdAt         DateTime           @default(now())
  attendanceSession AttendanceSession?
  courseOffering    CourseOffering     @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  room              Room?              @relation(fields: [roomId], references: [id])

  @@unique([courseOfferingId, date, startTime])
  @@index([courseOfferingId])
  @@index([date])
}

/// The attendance-taking period for a ClassSession.
/// Lifecycle: NOT_STARTED → OPEN → CLOSED → FINALIZED
model AttendanceSession {
  id                String                     @id @default(uuid())
  classSessionId    String                     @unique
  openedBy          String
  lifecycle         AttendanceSessionLifecycle @default(NOT_STARTED)
  openedAt          DateTime?
  closedAt          DateTime?
  finalizedAt       DateTime?
  qrTokenHash       String?
  qrTokenExpiry     DateTime?
  lateAfterMinutes  Int                        @default(10)
  closeAfterMinutes Int                        @default(30)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  openBeforeMinutes Int                        @default(15)
  records           AttendanceRecord[]
  classSession      ClassSession               @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([openedBy])
  @@index([lifecycle])
}

/// One student's attendance for one AttendanceSession.
model AttendanceRecord {
  id                  String                    @id @default(uuid())
  attendanceSessionId String
  studentRecordId     String
  status              AttendanceStatus          @default(PRESENT)
  method              AttendanceMethod          @default(MANUAL)
  markedAt            DateTime                  @default(now())
  markedBy            String
  note                String?
  correctionOf        String?
  correctionReason    String?
  correctedAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  corrections         AttendanceCorrectionLog[]
  attendanceSession   AttendanceSession         @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentRecord       StudentRecord             @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, studentRecordId])
  @@index([attendanceSessionId])
  @@index([studentRecordId])
}

/// Append-only audit log for attendance corrections.
model AttendanceCorrectionLog {
  id                 String           @id @default(uuid())
  attendanceRecordId String
  oldStatus          AttendanceStatus
  newStatus          AttendanceStatus
  reason             String
  changedBy          String
  changedAt          DateTime         @default(now())
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId])
}

model FinancialAccount {
  id                  String                 @id @default(uuid())
  studentRecordId     String                 @unique
  balance             Float                  @default(0.0)
  clearedForTerm      String?
  lastUpdatedAt       DateTime               @default(now())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  studentRecord       StudentRecord          @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)
  transactions        FinancialTransaction[]
  monthlyInstallments MonthlyInstallment[]

  @@index([studentRecordId])
}

model FinancialTransaction {
  id                 String           @id @default(uuid())
  financialAccountId String
  type               TransactionType
  amount             Float
  description        String
  category           String
  receiptId          String?          @unique
  status             String           @default("POSTED")
  referenceId        String?
  transactionDate    DateTime         @default(now())
  createdAt          DateTime         @default(now())
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@index([financialAccountId])
  @@index([transactionDate])
  @@index([type])
}

/// Tuition fee configuration per academic context, department/program, and duration.
/// Finance Officers create and manage these to set the monthly amount per student group.
model TuitionConfiguration {
  id                String               @id @default(uuid())
  academicContext   ProgramType
  departmentId      String
  programId         String?
  durationMonths    Int?
  academicYearLabel String?
  monthlyAmount     Float
  effectiveDate     DateTime             @default(now())
  isActive          Boolean              @default(true)
  description       String?
  createdByUserId   String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  installments      MonthlyInstallment[]
  department        Department           @relation(fields: [departmentId], references: [id])
  program           Program?             @relation(fields: [programId], references: [id])

  @@index([academicContext])
  @@index([departmentId])
  @@index([isActive])
}

/// One row per billing month per student. Status drives the payment countdown UI.
model MonthlyInstallment {
  id                 String                   @id @default(uuid())
  financialAccountId String
  studentRecordId    String
  tuitionConfigId    String?
  academicContext    ProgramType
  billingMonth       String
  billingLabel       String
  dueDate            DateTime
  expectedAmount     Float
  status             PaymentInstallmentStatus @default(UPCOMING)
  activeSubmissionId String?                  @unique
  receiptId          String?                  @unique
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  financialAccount   FinancialAccount         @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  receipt            PaymentReceipt?          @relation(fields: [receiptId], references: [id])
  studentRecord      StudentRecord            @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)
  tuitionConfig      TuitionConfiguration?    @relation(fields: [tuitionConfigId], references: [id])
  submissions        PaymentSubmission[]

  @@unique([studentRecordId, billingMonth])
  @@index([financialAccountId])
  @@index([studentRecordId])
  @@index([status])
  @@index([dueDate])
}

/// Student uploads payment evidence; FO reviews and approves/rejects.
model PaymentSubmission {
  id               String                  @id @default(uuid())
  installmentId    String
  studentRecordId  String
  amount           Float
  paymentDate      DateTime
  paymentMethod    String
  referenceNumber  String?
  evidenceUrl      String
  evidenceFileName String?
  note             String?
  status           PaymentSubmissionStatus @default(PENDING_REVIEW)
  rejectionReason  String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  receipt          PaymentReceipt?
  installment      MonthlyInstallment      @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  studentRecord    StudentRecord           @relation(fields: [studentRecordId], references: [id])

  @@index([installmentId])
  @@index([studentRecordId])
  @@index([status])
}

/// Official payment receipt generated by Finance Officer upon approval.
model PaymentReceipt {
  id               String              @id @default(uuid())
  receiptNumber    String              @unique
  installmentId    String              @unique
  submissionId     String              @unique
  studentRecordId  String
  amountPaid       Float
  paymentDate      DateTime
  paymentMethod    String?
  referenceNumber  String?
  billingMonth     String
  billingLabel     String
  approvedByUserId String
  approvedAt       DateTime            @default(now())
  createdAt        DateTime            @default(now())
  installment      MonthlyInstallment?
  studentRecord    StudentRecord       @relation(fields: [studentRecordId], references: [id])
  submission       PaymentSubmission   @relation(fields: [submissionId], references: [id])

  @@index([studentRecordId])
  @@index([approvedAt])
}

model AdvisorAppointment {
  id                 String            @id @default(uuid())
  studentRecordId    String
  advisorUserId      String
  topic              String
  requestedDate      DateTime
  requestedTime      String
  status             AppointmentStatus @default(PENDING)
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  meetingLink        String?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  studentRecord      StudentRecord     @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  @@index([studentRecordId])
  @@index([advisorUserId])
  @@index([status])
  @@index([requestedDate])
}

model StudentNotificationPreference {
  id               String        @id @default(uuid())
  studentRecordId  String        @unique
  gradeAlerts      Boolean       @default(true)
  tuitionReminders Boolean       @default(true)
  registrarNotices Boolean       @default(true)
  advisorMessages  Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  studentRecord    StudentRecord @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)
}

model DepartmentHeadRecord {
  id            String                   @id @default(uuid())
  userId        String                   @unique
  employeeId    String                   @unique
  title         String                   @default("Department Head")
  isActive      Boolean                  @default(true)
  departmentId  String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  department    Department               @relation(fields: [departmentId], references: [id])
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveRequests DepartmentLeaveRequest[]

  @@index([departmentId])
  @@index([isActive])
}

model DepartmentLeaveRequest {
  id               String                @id @default(uuid())
  /// Faculty member submitting the request
  instructorId     String
  leaveType        LeaveType
  startDate        DateTime
  endDate          DateTime
  durationDays     Int
  reason           String
  supportingDocUrl String?
  status           LeaveStatus           @default(PENDING_DH)
  /// Department Head who reviewed this request
  reviewedByDhId   String?
  dhComment        String?
  dhReviewedAt     DateTime?
  /// HR final decision
  hrComment        String?
  hrReviewedAt     DateTime?
  hrReviewedBy     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  instructor       InstructorRecord      @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  reviewedByDh     DepartmentHeadRecord? @relation(fields: [reviewedByDhId], references: [id])

  @@index([instructorId])
  @@index([status])
  @@index([startDate])
  @@index([reviewedByDhId])
}

model DepartmentHeadAuditLog {
  id          String               @id @default(uuid())
  userId      String
  action      DepartmentHeadAction
  entityType  String
  entityId    String
  description String
  metadata    Json?
  ipAddress   String?              @db.VarChar(45)
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

/// An HR department (separate from the academic Department model)
model HRDepartment {
  id             String       @id @default(uuid())
  name           String       @unique
  headEmployeeId String?
  budget         Float        @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employees      HREmployee[]

  @@index([isActive])
}

/// HR employee record — includes personal, employment, salary, and sensitive fields
model HREmployee {
  id                  String                @id @default(uuid())
  employeeCode        String                @unique
  userId              String?               @unique
  fullName            String
  avatarUrl           String?
  gender              HRGender
  dateOfBirth         DateTime?
  address             String?
  email               String                @unique
  phone               String?
  departmentId        String
  position            String
  employmentType      HREmploymentType      @default(FULL_TIME)
  contractStatus      HRContractStatus      @default(ACTIVE)
  status              HREmployeeStatus      @default(ACTIVE)
  hireDate            DateTime
  contractEndDate     DateTime?
  managerId           String?
  education           String?
  experienceYears     Int                   @default(0)
  basicSalary         Float                 @default(0)
  allowances          Float                 @default(0)
  deductions          Float                 @default(0)
  nationalId          String?
  bankAccount         String?
  taxNumber           String?
  emergencyName       String?
  emergencyPhone      String?
  emergencyRelation   String?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  certificateFileSize String?
  certificateUrl      String?
  courseId            String?
  faydaIdFileSize     String?
  faydaIdUrl          String?
  systemRole          String?
  contractRenewals    HRContractRenewal[]
  documents           HRDocument[]
  department          HRDepartment          @relation(fields: [departmentId], references: [id])
  manager             HREmployee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates        HREmployee[]          @relation("EmployeeManager")
  user                User?                 @relation(fields: [userId], references: [id])
  leaveBalances       HRLeaveBalance[]
  leaveRequests       HRLeaveRequest[]
  offboardingRecord   HROffboardingRecord?
  onboardingRecord    HROnboardingRecord?
  payslips            HRPayslip[]
  performanceReviews  HRPerformanceReview[]
  salaryHistory       HRSalaryHistory[]

  @@index([status])
  @@index([departmentId])
  @@index([contractStatus])
  @@index([employmentType])
  @@index([isActive])
  @@index([systemRole])
}

/// Leave request raised by an employee
model HRLeaveRequest {
  id               String           @id @default(uuid())
  employeeId       String
  leaveType        HRLeaveType
  startDate        DateTime
  endDate          DateTime
  daysCount        Int
  reason           String
  status           HRLeaveStatus    @default(PENDING)
  managerApproval  HRApprovalStatus @default(PENDING)
  hrApproval       HRApprovalStatus @default(PENDING)
  reviewComment    String?
  reviewedByUserId String?
  submittedAt      DateTime         @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  employee         HREmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([leaveType])
  @@index([startDate])
}

/// Running leave balance per employee per type
model HRLeaveBalance {
  id         String      @id @default(uuid())
  employeeId String
  leaveType  HRLeaveType
  entitled   Int         @default(0)
  taken      Int         @default(0)
  remaining  Int         @default(0)
  year       Int
  employee   HREmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
}

/// Monthly payroll batch
model HRPayrollRecord {
  id            String              @id @default(uuid())
  month         String
  year          Int
  stage         HRPayrollStage      @default(DRAFT)
  totalGross    Float               @default(0)
  totalNet      Float               @default(0)
  employeeCount Int                 @default(0)
  generatedAt   DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  approvals     HRPayrollApproval[]
  payslips      HRPayslip[]

  @@unique([month, year])
  @@index([stage])
  @@index([year])
}

/// Individual payroll approval step
model HRPayrollApproval {
  id           String           @id @default(uuid())
  payrollId    String
  stageName    String
  approverName String
  approvedAt   DateTime?
  status       HRApprovalStatus @default(PENDING)
  comment      String?
  createdAt    DateTime         @default(now())
  payroll      HRPayrollRecord  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
}

/// Individual employee payslip in a payroll batch
model HRPayslip {
  id              String          @id @default(uuid())
  payrollId       String
  employeeId      String
  basicSalary     Float
  allowances      Float           @default(0)
  bonuses         Float           @default(0)
  tax             Float           @default(0)
  pension         Float           @default(0)
  otherDeductions Float           @default(0)
  netSalary       Float
  createdAt       DateTime        @default(now())
  employee        HREmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payroll         HRPayrollRecord @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@unique([payrollId, employeeId])
  @@index([payrollId])
  @@index([employeeId])
}

/// Semi-annual / quarterly / annual performance review
model HRPerformanceReview {
  id                 String         @id @default(uuid())
  employeeId         String
  cycle              HRReviewCycle
  period             String
  status             HRReviewStatus @default(PENDING)
  dueDate            DateTime
  overallScore       Float?
  goalsScore         Float?
  competenciesScore  Float?
  attendanceScore    Float?
  communicationScore Float?
  leadershipScore    Float?
  technicalScore     Float?
  managerComment     String?
  hrComment          String?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  employee           HREmployee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([dueDate])
}

/// Documents linked to an employee
model HRDocument {
  id               String             @id @default(uuid())
  employeeId       String
  category         HRDocumentCategory
  title            String
  fileUrl          String?
  fileSize         String?
  uploadedByUserId String?
  uploadedByName   String?
  version          Int                @default(1)
  uploadedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())
  employee         HREmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([category])
}

/// Onboarding checklist for a new hire
model HROnboardingRecord {
  id          String             @id @default(uuid())
  employeeId  String             @unique
  currentStep Int                @default(0)
  status      HROnboardingStatus @default(NOT_STARTED)
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  employee    HREmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  steps       HROnboardingStep[]
}

model HROnboardingStep {
  id         String             @id @default(uuid())
  recordId   String
  stepKey    String
  label      String
  completed  Boolean            @default(false)
  orderIndex Int
  record     HROnboardingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, stepKey])
  @@index([recordId])
}

/// Offboarding record for a departing employee
model HROffboardingRecord {
  id             String              @id @default(uuid())
  employeeId     String              @unique
  lastWorkingDay DateTime
  exitReason     HRExitReason
  currentStep    Int                 @default(0)
  status         HROffboardingStatus @default(NOT_STARTED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  assetChecklist HRAssetCheckItem[]
  employee       HREmployee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model HRAssetCheckItem {
  id       String              @id @default(uuid())
  recordId String
  item     String
  returned Boolean             @default(false)
  notes    String?
  record   HROffboardingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

/// Append-only HR audit log
model HRAuditLog {
  id           String        @id @default(uuid())
  actorUserId  String?
  actorName    String
  action       String
  employeeName String        @default("All Staff")
  module       String
  description  String
  status       HRAuditStatus @default(SUCCESS)
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([actorUserId])
  @@index([module])
  @@index([createdAt])
  @@index([status])
}

/// Append-only salary change record. Created every time an employee's salary is updated.
model HRSalaryHistory {
  id              String     @id @default(uuid())
  employeeId      String
  effectiveDate   DateTime
  basicSalary     Float
  allowances      Float      @default(0)
  deductions      Float      @default(0)
  grossSalary     Float
  reason          String?
  changedByUserId String?
  changedByName   String
  createdAt       DateTime   @default(now())
  employee        HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([effectiveDate])
}

/// A contract renewal record created when HR renews or extends an employee contract.
model HRContractRenewal {
  id               String     @id @default(uuid())
  employeeId       String
  previousEndDate  DateTime
  newEndDate       DateTime
  reason           String?
  documentId       String?
  approvedByUserId String?
  approvedByName   String
  approvedAt       DateTime   @default(now())
  createdAt        DateTime   @default(now())
  employee         HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model StaffInvitation {
  id               String      @id @default(uuid())
  email            String
  fullName         String
  role             Role
  departmentId     String?
  positionTitle    String?
  employeeId       String?
  phone            String?
  specialization   String?
  tokenHash        String      @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  invitedByUserId  String
  acceptedByUserId String?     @unique
  acceptedByUser   User?       @relation("AcceptedInvitation", fields: [acceptedByUserId], references: [id])
  department       Department? @relation(fields: [departmentId], references: [id])
  invitedByUser    User        @relation("SentInvitations", fields: [invitedByUserId], references: [id])

  @@index([email])
  @@index([tokenHash])
  @@index([invitedByUserId])
  @@index([departmentId])
  @@index([role])
  @@index([expiresAt])
}

