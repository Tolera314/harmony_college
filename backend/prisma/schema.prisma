generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS — Auth
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  REGISTRAR
  FINANCE_OFFICER
  HR_OFFICER
  DEPARTMENT_HEAD
  INSTRUCTOR
  STUDENT
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
  LOCKED
}

enum VerificationTokenType {
  PHONE_OTP
  EMAIL_TOKEN
}

/// Supported OAuth / OIDC Identity Providers.
enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

/// Audit log event types for authentication and account lifecycle events.
/// No passwords, tokens, OTPs, or other secrets are ever stored here.
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  ROLE_CHANGED
  ACCOUNT_SUSPENDED
  ACCOUNT_DEACTIVATED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PROFILE_COMPLETED
  SESSION_REVOKED
  OAUTH_LINKED
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS — Registrar Academic
// ─────────────────────────────────────────────────────────────────────────────

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum StudentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OfferingStatus {
  DRAFT
  INSTRUCTOR_ASSIGNED
  SCHEDULED
  ACTIVE
  CLOSED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
  WAITLISTED
  FORCE_ADDED
  FORCE_DROPPED
}

enum TranscriptRequestStatus {
  PENDING
  PROCESSING
  ISSUED
  REJECTED
}

enum GraduationStatus {
  PENDING
  ELIGIBLE
  APPROVED
  REJECTED
  GRADUATED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Tracks where a student is in the post-admission onboarding pipeline.
enum OnboardingStatus {
  /// Profile submitted, waiting for student to upload their registration screenshot.
  PENDING
  /// Student has uploaded the registration screenshot; awaiting registrar/admin approval.
  SUBMITTED
  /// Approved — student may access the full dashboard.
  APPROVED
  /// Rejected — student must re-upload.
  REJECTED
}

enum CalendarEventType {
  REGISTRATION_OPEN
  REGISTRATION_CLOSE
  ADD_DROP_DEADLINE
  EXAM_PERIOD
  HOLIDAY
  GRADUATION
  ADMISSION_DEADLINE
  SEMESTER_START
  SEMESTER_END
  ACADEMIC_EVENT
}

enum RegistrarAction {
  ADMISSION_APPROVED
  ADMISSION_REJECTED
  ADMISSION_REVIEW_REQUESTED
  ADMISSION_COMMENT_ADDED
  STUDENT_CREATED
  STUDENT_UPDATED
  STUDENT_SUSPENDED
  STUDENT_REACTIVATED
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_DEACTIVATED
  COURSE_REACTIVATED
  OFFERING_CREATED
  OFFERING_UPDATED
  OFFERING_CANCELLED
  ENROLLMENT_ADDED
  ENROLLMENT_DROPPED
  ENROLLMENT_FORCE_ADDED
  ENROLLMENT_FORCE_DROPPED
  TIMETABLE_CREATED
  TIMETABLE_UPDATED
  TIMETABLE_DELETED
  TRANSCRIPT_GENERATED
  TRANSCRIPT_REQUEST_APPROVED
  TRANSCRIPT_REQUEST_REJECTED
  GRADUATION_APPROVED
  GRADUATION_REJECTED
  CERTIFICATE_ISSUED
  CERTIFICATE_REVOKED
  ANNOUNCEMENT_PUBLISHED
  ANNOUNCEMENT_ARCHIVED
  CALENDAR_EVENT_CREATED
  CALENDAR_EVENT_UPDATED
  CALENDAR_EVENT_DELETED
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH MODELS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id String @id @default(uuid())

  fullName String
  email    String?  @unique
  phone    String?  @unique

  // ── Credentials ───────────────────────────────────────────────────────────
  /// bcrypt hash of the user's password. Optional for OAuth-only users. NEVER store plaintext.
  passwordHash String?

  role   Role          @default(STUDENT)
  status AccountStatus @default(PENDING_VERIFICATION)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  profileCompleted  Boolean @default(false)
  profileCompletion Int     @default(0)

  failedLoginAttempts Int @default(0)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ── Relations ─────────────────────────────────────────────────────────────
  sessions            Session[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  oauthAccounts       OAuthAccount[]
  studentProfile      StudentProfile?
  application         Application?

  conversations ConversationParticipant[]
  messages      Message[]

  // Registrar relations
  studentRecord    StudentRecord?
  instructorRecord InstructorRecord?
  registrarLogs    RegistrarAuditLog[]

  @@index([role])
  @@index([status])
  @@index([email])
  @@index([phone])
}

/// Federated OAuth identity linked to a User account.
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// An authenticated session tied to a specific device/browser.
/// One user can have many sessions (multi-device).
/// Deleting a session immediately invalidates the corresponding refresh token.
model Session {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String
  deviceInfo       String?  @db.VarChar(255)
  ipAddress        String?  @db.VarChar(45)
  isRevoked        Boolean  @default(false)

  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      VerificationTokenType
  tokenHash String
  attempts  Int      @default(0)
  used      Boolean  @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String
  attempts  Int      @default(0)
  used      Boolean  @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    AuditAction
  metadata  Json?
  ipAddress String?   @db.VarChar(45)
  userAgent String?   @db.VarChar(255)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT PROFILE (onboarding wizard data)
// ─────────────────────────────────────────────────────────────────────────────

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dob         DateTime?
  gender      String?
  nationality String?
  region      String?
  city        String?
  address     String?

  program      String?
  academicYear String?
  semester     String?
  matricResult     String?
  ministryResult   String?

  profilePictureUrl String?
  faydaIdUrl        String?
  transcriptUrl     String?

  emergencyName         String?
  emergencyRelationship String?
  emergencyPhone        String?
  emergencyNotes        String?

  /// Department chosen on the /onboarding/about page (pre-enrollment preference).
  selectedDepartmentId  String?
  selectedDepartment    Department? @relation(fields: [selectedDepartmentId], references: [id])
  /// Set to true once the student confirms registration fee payment on /onboarding/about.
  registrationFeePaid   Boolean  @default(false)
  registrationFeePaidAt DateTime?
  /// Set to true once the student picks a department on /onboarding/about.
  departmentSelected    Boolean  @default(false)
  /// Set to true once a Finance Officer verifies the student's registration fee payment.
  paymentVerifiedByFinance   Boolean   @default(false)
  paymentVerifiedAt          DateTime?
  paymentVerifiedByUserId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// APPLICATION (legacy admissions form — extended with proper enum status)
// ─────────────────────────────────────────────────────────────────────────────

model Application {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName         String
  dob              DateTime
  age              Int
  gender           String
  nationality      String
  emergencyContact String
  phone            String
  city             String
  address          String
  program          String
  academicYear     String
  semester         String
  studyMode        String

  status        ApplicationStatus @default(DRAFT)
  reviewComment String?
  reviewedBy    String?
  reviewedAt    DateTime?

  // ── Post-admission onboarding ─────────────────────────────────────────────
  onboardingStatus              OnboardingStatus @default(PENDING)
  registrationScreenshotUrl     String?
  screenshotUploadedAt          DateTime?
  onboardingReviewedBy          String?
  onboardingReviewedAt          DateTime?
  onboardingRejectionReason     String?

  documents   Document[]
  submittedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([program])
  @@index([academicYear])
}

model Document {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type       String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false)
  name      String?
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String   @db.VarChar(4000)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC FOUNDATION
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  code        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs         Program[]
  courses          Course[]
  instructors      InstructorRecord[]
  studentRecords   StudentRecord[]
  onboardingStudents StudentProfile[]

  @@index([code])
  @@index([isActive])
}

model Program {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  description  String?
  durationYears Int    @default(4)
  totalCredits Int     @default(120)
  isActive     Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses        ProgramCourse[]
  studentRecords StudentRecord[]
  requirements   ProgramRequirement[]

  @@index([departmentId])
  @@index([isActive])
}

model AcademicYear {
  id         String   @id @default(uuid())
  name       String   @unique   // e.g. "2024-2025"
  startDate  DateTime
  endDate    DateTime
  isCurrent  Boolean  @default(false)
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters      Semester[]
  calendarEvents AcademicCalendarEvent[]

  @@index([isCurrent])
}

model Semester {
  id           String   @id @default(uuid())
  name         String                  // "Semester I", "Semester II"
  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  startDate         DateTime
  endDate           DateTime
  registrationStart DateTime
  registrationEnd   DateTime
  addDropDeadline   DateTime
  isCurrent         Boolean  @default(false)
  isActive          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings CourseOffering[]

  @@unique([academicYearId, name])
  @@index([isCurrent])
}

model Course {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  description String?
  creditHours Int         @default(3)
  status      CourseStatus @default(ACTIVE)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prerequisites   CoursePrerequisite[] @relation("CoursePrereqs")
  requiredBy      CoursePrerequisite[] @relation("PrereqFor")
  offerings       CourseOffering[]
  programCourses  ProgramCourse[]

  @@index([code])
  @@index([departmentId])
  @@index([status])
}

model CoursePrerequisite {
  id           String @id @default(uuid())
  courseId     String
  course       Course @relation("CoursePrereqs", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteId String
  prerequisite   Course @relation("PrereqFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteId])
  @@index([courseId])
}

model ProgramCourse {
  id         String  @id @default(uuid())
  programId  String
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isRequired Boolean @default(true)
  yearLevel  Int     @default(1)

  @@unique([programId, courseId])
}

model ProgramRequirement {
  id             String  @id @default(uuid())
  programId      String
  program        Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  category       String  // "CORE", "ELECTIVE", "GENERAL"
  description    String?
  requiredCredits Int
  minimumGPA     Float   @default(2.0)

  @@index([programId])
}

model Room {
  id       String   @id @default(uuid())
  name     String
  building String
  capacity Int
  roomType RoomType @default(CLASSROOM)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings  CourseOffering[]
  timetables TimetableSlot[]
  classSessions ClassSession[]

  @@unique([building, name])
  @@index([building])
  @@index([isActive])
  @@index([roomType])
}

// ─────────────────────────────────────────────────────────────────────────────
// INSTRUCTORS
// ─────────────────────────────────────────────────────────────────────────────

model InstructorRecord {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId   String  @unique
  title        String  @default("Instructor")
  specialization String?
  isActive     Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings  CourseOffering[]
  timetables TimetableSlot[]

  @@index([departmentId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT RECORDS (academic record, distinct from StudentProfile/auth)
// ─────────────────────────────────────────────────────────────────────────────

model StudentRecord {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId    String        @unique  // e.g. HC-2024-0012
  status       StudentStatus @default(ACTIVE)

  programId    String
  program      Program    @relation(fields: [programId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  yearLevel    Int     @default(1)
  gpa          Float   @default(0.0)
  totalCredits Int     @default(0)
  admittedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments       Enrollment[]
  transcriptRequests TranscriptRequest[]
  graduationAudit    GraduationAudit?
  certificate        Certificate?
  courseGrades       CourseGrade[]
  assignmentSubmissions AssignmentSubmission[]
  quizAttempts          QuizAttempt[]
  attendanceRecords     AttendanceRecord[]
  financialAccount      FinancialAccount?
  advisorAppointments   AdvisorAppointment[]
  notificationPreference StudentNotificationPreference?
  @@index([studentId])
  @@index([programId])
  @@index([departmentId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// COURSE OFFERINGS
// ─────────────────────────────────────────────────────────────────────────────

model CourseOffering {
  id         String         @id @default(uuid())
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id])
  semesterId String
  semester   Semester       @relation(fields: [semesterId], references: [id])
  status     OfferingStatus @default(DRAFT)

  instructorId String?
  instructor   InstructorRecord? @relation(fields: [instructorId], references: [id])

  roomId   String?
  room     Room?   @relation(fields: [roomId], references: [id])

  capacity Int @default(40)
  section  String @default("A")   // A, B, C for multiple sections

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  timetables  TimetableSlot[]
  assignments Assignment[]
  quizzes     Quiz[]
  classSessions      ClassSession[]

  @@unique([courseId, semesterId, section])
  @@index([semesterId])
  @@index([courseId])
  @@index([instructorId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────────────────────────────────────────

model TimetableSlot {
  id               String @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  dayOfWeek  Int                 // 0=Mon, 1=Tue, ..., 4=Fri
  startTime  String              // "09:00"
  endTime    String              // "10:30"
  status     TimetableSlotStatus @default(PUBLISHED)

  roomId       String?
  room         Room?         @relation(fields: [roomId], references: [id])
  instructorId String?
  instructor   InstructorRecord? @relation(fields: [instructorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseOfferingId])
  @@index([roomId])
  @@index([dayOfWeek])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ENROLLMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Enrollment {
  id               String           @id @default(uuid())
  studentRecordId  String
  studentRecord    StudentRecord    @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id])
  status           EnrollmentStatus @default(ACTIVE)

  enrolledAt DateTime @default(now())
  droppedAt  DateTime?
  dropReason String?

  // Override fields (force-add/force-drop)
  isOverride      Boolean @default(false)
  overrideReason  String?
  overrideBy      String?   // userId of registrar
  overrideAt      DateTime?

  grade       CourseGrade?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentRecordId, courseOfferingId])
  @@index([studentRecordId])
  @@index([courseOfferingId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// GRADES
// ─────────────────────────────────────────────────────────────────────────────

model CourseGrade {
  id             String @id @default(uuid())
  enrollmentId   String @unique
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentRecordId String
  studentRecord  StudentRecord @relation(fields: [studentRecordId], references: [id])

  letterGrade    String?   // A, B+, B, C+, C, D, F
  gradePoints    Float?    // 4.0, 3.5, 3.0, ...
  creditHours    Int

  gradedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([studentRecordId])
  @@index([enrollmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRANSCRIPTS
// ─────────────────────────────────────────────────────────────────────────────

model TranscriptRequest {
  id              String                  @id @default(uuid())
  studentRecordId String
  studentRecord   StudentRecord           @relation(fields: [studentRecordId], references: [id])
  status          TranscriptRequestStatus @default(PENDING)
  purpose         String?
  requestedAt     DateTime                @default(now())
  processedAt     DateTime?
  processedBy     String?
  rejectionReason String?
  issuedAt        DateTime?
  documentUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentRecordId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// GRADUATION
// ─────────────────────────────────────────────────────────────────────────────

model GraduationAudit {
  id              String           @id @default(uuid())
  studentRecordId String           @unique
  studentRecord   StudentRecord    @relation(fields: [studentRecordId], references: [id])
  status          GraduationStatus @default(PENDING)

  completedCredits Int     @default(0)
  requiredCredits  Int     @default(120)
  currentGpa       Float   @default(0.0)
  requiredGpa      Float   @default(2.0)
  isEligible       Boolean @default(false)

  auditNotes    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  graduatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// CERTIFICATES
// ─────────────────────────────────────────────────────────────────────────────

model Certificate {
  id              String            @id @default(uuid())
  studentRecordId String            @unique
  studentRecord   StudentRecord     @relation(fields: [studentRecordId], references: [id])
  status          CertificateStatus @default(ISSUED)

  certificateNumber String @unique
  verificationCode  String @unique
  issuedAt          DateTime @default(now())
  issuedBy          String

  revokedAt     DateTime?
  revokedBy     String?
  revocationReason String?

  documentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationCode])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC CALENDAR
// ─────────────────────────────────────────────────────────────────────────────

model AcademicCalendarEvent {
  id             String            @id @default(uuid())
  title          String
  description    String?
  eventType      CalendarEventType
  startDate      DateTime
  endDate        DateTime
  isPublished    Boolean           @default(false)
  academicYearId String?
  academicYear   AcademicYear?     @relation(fields: [academicYearId], references: [id])

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType])
  @@index([startDate])
  @@index([isPublished])
}

// ─────────────────────────────────────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id              String             @id @default(uuid())
  title           String
  content         String             @db.Text
  status          AnnouncementStatus @default(DRAFT)
  priority        String             @default("NORMAL") // HIGH, NORMAL, LOW
  targetAudience  String             @default("ALL")    // ALL, DEPARTMENT:<id>, PROGRAM:<id>
  publishDate     DateTime?
  expirationDate  DateTime?
  createdBy       String
  publishedBy     String?
  publishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// REGISTRAR AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model RegistrarAuditLog {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  action      RegistrarAction
  entityType  String          // "Application", "StudentRecord", "Course", etc.
  entityId    String
  description String
  metadata    Json?
  ipAddress   String?         @db.VarChar(45)
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  isRead     Boolean  @default(false)
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// GRADE SCALE (registrar-managed, replaces hardcoded grade point map)
// ─────────────────────────────────────────────────────────────────────────────

model GradeScale {
  id           String   @id @default(uuid())
  letterGrade  String   @unique  // "A", "A-", "B+", "B", etc.
  gradePoints  Float             // 4.0, 3.7, 3.5, etc.
  description  String?           // "Excellent", "Very Good", etc.
  isPassing    Boolean  @default(true)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([letterGrade])
}
// ─────────────────────────────────────────────────────────────────────────────

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  ESSAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSessionLifecycle {
  NOT_STARTED
  OPEN
  CLOSED
  FINALIZED
}

enum AttendanceMethod {
  MANUAL
  QR
}

enum RoomType {
  CLASSROOM
  LAB
  LECTURE_HALL
  EXAM_HALL
  SEMINAR_ROOM
}

enum TimetableSlotStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TransactionType {
  TUITION
  FEE
  SCHOLARSHIP
  GRANT
  PAYMENT
  REFUND
  PENALTY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSIGNMENTS (instructor-created, linked to a CourseOffering)
// ─────────────────────────────────────────────────────────────────────────────

model Assignment {
  id               String           @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  createdBy        String           // instructorRecord.userId

  title            String
  description      String           @db.Text
  instructions     String           @db.Text
  dueDate          DateTime
  totalPoints      Int              @default(100)
  status           AssignmentStatus @default(DRAFT)
  allowLateSubmit  Boolean          @default(false)
  maxFileSize      Int              @default(250) // MB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments  AssignmentAttachment[]
  submissions  AssignmentSubmission[]

  @@index([courseOfferingId])
  @@index([dueDate])
  @@index([status])
}

model AssignmentAttachment {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     String     // human-readable e.g. "420 KB"
  fileType     String     // "PDF", "TXT", etc.
  uploadedAt   DateTime   @default(now())

  @@index([assignmentId])
}

model AssignmentSubmission {
  id             String           @id @default(uuid())
  assignmentId   String
  assignment     Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentRecordId String
  studentRecord  StudentRecord    @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  status         SubmissionStatus @default(SUBMITTED)
  submittedAt    DateTime         @default(now())

  // Submission content
  fileUrl        String?
  fileName       String?
  fileSize       String?
  textContent    String?          @db.Text

  // Grading
  score          Float?
  letterGrade    String?
  feedback       String?          @db.Text
  gradedAt       DateTime?
  gradedBy       String?          // instructorRecord.userId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentRecordId])
  @@index([assignmentId])
  @@index([studentRecordId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUIZZES
// ─────────────────────────────────────────────────────────────────────────────

model Quiz {
  id               String         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  createdBy        String         // instructorRecord.userId

  title                  String
  description            String?
  instructions           String?          @db.Text
  durationMinutes        Int              @default(30)
  availableFrom          DateTime
  availableUntil         DateTime
  passingScore           Int              @default(60)   // percentage
  maxAttempts            Int              @default(1)
  totalPoints            Int              @default(100)
  showResultsImmediately Boolean          @default(true)
  status                 QuizStatus       @default(DRAFT)
  shuffleQuestions       Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseOfferingId])
  @@index([status])
  @@index([availableFrom])
  @@index([availableUntil])
}

model QuizQuestion {
  id           String       @id @default(uuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String       @db.Text
  type         QuestionType
  points       Int          @default(1)
  orderIndex   Int          @default(0)

  options      QuizQuestionOption[]
  answers      QuizAnswer[]

  @@index([quizId])
  @@index([orderIndex])
}

model QuizQuestionOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  orderIndex Int          @default(0)

  @@index([questionId])
}

model QuizAttempt {
  id              String            @id @default(uuid())
  quizId          String
  quiz            Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentRecordId String
  studentRecord   StudentRecord     @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  status          QuizAttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime          @default(now())
  submittedAt     DateTime?
  timeSpentSeconds Int?

  score           Float?
  percentageScore Float?
  isPassing       Boolean?
  feedback        String?          @db.Text
  gradedAt        DateTime?
  gradedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers QuizAnswer[]

  @@index([quizId])
  @@index([studentRecordId])
  @@index([status])
}

model QuizAnswer {
  id          String       @id @default(uuid())
  attemptId   String
  attempt     QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerText  String?      @db.Text   // for open-ended
  selectedOptionId String? // for MCQ / TrueFalse

  isCorrect   Boolean?
  pointsEarned Float?

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE (full spec per attendance.md)
// ─────────────────────────────────────────────────────────────────────────────

/// A specific physical class meeting derived from a TimetableSlot.
model ClassSession {
  id               String         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  date      DateTime  // The actual calendar date of this session
  startTime String    // "09:00"
  endTime   String    // "10:30"
  topic     String?
  roomId    String?
  room      Room?     @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())

  attendanceSession AttendanceSession?

  @@unique([courseOfferingId, date, startTime])
  @@index([courseOfferingId])
  @@index([date])
}

/// The attendance-taking period for a ClassSession.
/// Lifecycle: NOT_STARTED → OPEN → CLOSED → FINALIZED
model AttendanceSession {
  id             String                     @id @default(uuid())
  classSessionId String                     @unique
  classSession   ClassSession               @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  openedBy       String                     // InstructorRecord.userId
  lifecycle      AttendanceSessionLifecycle @default(NOT_STARTED)

  openedAt    DateTime?
  closedAt    DateTime?
  finalizedAt DateTime?

  // QR attendance token (hashed — raw token sent to frontend only once)
  qrTokenHash  String?
  qrTokenExpiry DateTime?

  // Policy overrides for this session
  openBeforeMinutes Int @default(15)   // how early attendance can open before class start
  lateAfterMinutes  Int @default(10)
  closeAfterMinutes Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records AttendanceRecord[]

  @@index([openedBy])
  @@index([lifecycle])
}

/// One student's attendance for one AttendanceSession.
model AttendanceRecord {
  id                  String              @id @default(uuid())
  attendanceSessionId String
  attendanceSession   AttendanceSession   @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentRecordId     String
  studentRecord       StudentRecord       @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  status   AttendanceStatus  @default(PRESENT)
  method   AttendanceMethod  @default(MANUAL)
  markedAt DateTime          @default(now())
  markedBy String            // userId who marked (instructor or student via QR)
  note     String?

  // Correction tracking
  correctionOf    String?           // ID of previous record this corrects
  correctionReason String?
  correctedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corrections AttendanceCorrectionLog[]

  @@unique([attendanceSessionId, studentRecordId])
  @@index([attendanceSessionId])
  @@index([studentRecordId])
}

/// Append-only audit log for attendance corrections.
model AttendanceCorrectionLog {
  id                 String           @id @default(uuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  oldStatus AttendanceStatus
  newStatus AttendanceStatus
  reason    String
  changedBy String            // userId
  changedAt DateTime          @default(now())

  @@index([attendanceRecordId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCIALS
// ─────────────────────────────────────────────────────────────────────────────

model FinancialAccount {
  id              String        @id @default(uuid())
  studentRecordId String        @unique
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  balance         Float         @default(0.0)   // 0 = cleared
  clearedForTerm  String?                        // e.g. "Fall 2024"
  lastUpdatedAt   DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinancialTransaction[]

  @@index([studentRecordId])
}

model FinancialTransaction {
  id                String          @id @default(uuid())
  financialAccountId String
  financialAccount  FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  type        TransactionType
  amount      Float            // positive = charge, negative = credit
  description String
  category    String           // "Tuition", "Fee", "Scholarship", etc.
  receiptId   String?          @unique
  status      String           @default("POSTED") // POSTED, PENDING, REVERSED
  referenceId String?          // payment gateway reference

  transactionDate DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@index([financialAccountId])
  @@index([transactionDate])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// ADVISOR APPOINTMENTS
// ─────────────────────────────────────────────────────────────────────────────

model AdvisorAppointment {
  id              String            @id @default(uuid())
  studentRecordId String
  studentRecord   StudentRecord     @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)
  advisorUserId   String            // instructor userId acting as advisor

  topic           String
  requestedDate   DateTime
  requestedTime   String            // "10:00", "11:30", etc.
  status          AppointmentStatus @default(PENDING)

  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  meetingLink     String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentRecordId])
  @@index([advisorUserId])
  @@index([status])
  @@index([requestedDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT NOTIFICATION PREFERENCES
// ─────────────────────────────────────────────────────────────────────────────

model StudentNotificationPreference {
  id              String        @id @default(uuid())
  studentRecordId String        @unique
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  gradeAlerts       Boolean @default(true)
  tuitionReminders  Boolean @default(true)
  registrarNotices  Boolean @default(true)
  advisorMessages   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
