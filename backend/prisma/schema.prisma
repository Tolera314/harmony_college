generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS — Auth
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  REGISTRAR
  FINANCE_OFFICER
  HR_OFFICER
  DEPARTMENT_HEAD
  INSTRUCTOR
  STUDENT
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
  LOCKED
}

enum VerificationTokenType {
  PHONE_OTP
  EMAIL_TOKEN
}

/// Supported OAuth / OIDC Identity Providers.
enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

/// Audit log event types for authentication and account lifecycle events.
/// No passwords, tokens, OTPs, or other secrets are ever stored here.
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  ROLE_CHANGED
  ACCOUNT_SUSPENDED
  ACCOUNT_DEACTIVATED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PROFILE_COMPLETED
  SESSION_REVOKED
  OAUTH_LINKED
  STAFF_INVITATION_CREATED
  STAFF_INVITATION_RESENT
  STAFF_INVITATION_REVOKED
  STAFF_INVITATION_ACCEPTED
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS — Registrar Academic
// ─────────────────────────────────────────────────────────────────────────────

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum StudentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OfferingStatus {
  DRAFT
  INSTRUCTOR_ASSIGNED
  SCHEDULED
  ACTIVE
  CLOSED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
  WAITLISTED
  FORCE_ADDED
  FORCE_DROPPED
}

enum TranscriptRequestStatus {
  PENDING
  PROCESSING
  ISSUED
  REJECTED
}

enum GraduationStatus {
  PENDING
  ELIGIBLE
  APPROVED
  REJECTED
  GRADUATED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Tracks where a student is in the post-admission onboarding pipeline.
enum OnboardingStatus {
  /// Profile submitted, waiting for student to upload their registration screenshot.
  PENDING
  /// Student has uploaded the registration screenshot; awaiting registrar/admin approval.
  SUBMITTED
  /// Approved — student may access the full dashboard.
  APPROVED
  /// Rejected — student must re-upload.
  REJECTED
}

enum CalendarEventType {
  REGISTRATION_OPEN
  REGISTRATION_CLOSE
  ADD_DROP_DEADLINE
  EXAM_PERIOD
  HOLIDAY
  GRADUATION
  ADMISSION_DEADLINE
  SEMESTER_START
  SEMESTER_END
  ACADEMIC_EVENT
}

enum RegistrarAction {
  ADMISSION_APPROVED
  ADMISSION_REJECTED
  ADMISSION_REVIEW_REQUESTED
  ADMISSION_COMMENT_ADDED
  STUDENT_CREATED
  STUDENT_UPDATED
  STUDENT_SUSPENDED
  STUDENT_REACTIVATED
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_DEACTIVATED
  COURSE_REACTIVATED
  OFFERING_CREATED
  OFFERING_UPDATED
  OFFERING_CANCELLED
  ENROLLMENT_ADDED
  ENROLLMENT_DROPPED
  ENROLLMENT_FORCE_ADDED
  ENROLLMENT_FORCE_DROPPED
  TIMETABLE_CREATED
  TIMETABLE_UPDATED
  TIMETABLE_DELETED
  TRANSCRIPT_GENERATED
  TRANSCRIPT_REQUEST_APPROVED
  TRANSCRIPT_REQUEST_REJECTED
  GRADUATION_APPROVED
  GRADUATION_REJECTED
  CERTIFICATE_ISSUED
  CERTIFICATE_REVOKED
  ANNOUNCEMENT_PUBLISHED
  ANNOUNCEMENT_ARCHIVED
  CALENDAR_EVENT_CREATED
  CALENDAR_EVENT_UPDATED
  CALENDAR_EVENT_DELETED
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH MODELS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id String @id @default(uuid())

  fullName String
  email    String? @unique
  phone    String? @unique

  // ── Credentials ───────────────────────────────────────────────────────────
  /// bcrypt hash of the user's password. Optional for OAuth-only users. NEVER store plaintext.
  passwordHash String?

  role   Role          @default(STUDENT)
  status AccountStatus @default(PENDING_VERIFICATION)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  profileCompleted  Boolean @default(false)
  profileCompletion Int     @default(0)

  failedLoginAttempts Int @default(0)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ── Relations ─────────────────────────────────────────────────────────────
  sessions            Session[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  oauthAccounts       OAuthAccount[]
  studentProfile      StudentProfile?
  application         Application?

  conversations ConversationParticipant[]
  messages      Message[]

  // Registrar relations
  studentRecord    StudentRecord?
  instructorRecord InstructorRecord?
  registrarLogs    RegistrarAuditLog[]

  // Department Head relations
  departmentHeadRecord DepartmentHeadRecord?
  dhAuditLogs          DepartmentHeadAuditLog[]
  // HR relation
  hrEmployee       HREmployee?

  // Staff Invitation relations
  sentInvitations    StaffInvitation[] @relation("SentInvitations")
  acceptedInvitation StaffInvitation?  @relation("AcceptedInvitation")

  @@index([role])
  @@index([status])
  @@index([email])
  @@index([phone])
}

/// Federated OAuth identity linked to a User account.
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// An authenticated session tied to a specific device/browser.
/// One user can have many sessions (multi-device).
/// Deleting a session immediately invalidates the corresponding refresh token.
model Session {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String
  deviceInfo       String? @db.VarChar(255)
  ipAddress        String? @db.VarChar(45)
  isRevoked        Boolean @default(false)

  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      VerificationTokenType
  tokenHash String
  attempts  Int                   @default(0)
  used      Boolean               @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String
  attempts  Int     @default(0)
  used      Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    AuditAction
  metadata  Json?
  ipAddress String?     @db.VarChar(45)
  userAgent String?     @db.VarChar(255)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT PROFILE (onboarding wizard data)
// ─────────────────────────────────────────────────────────────────────────────

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dob         DateTime?
  gender      String?
  nationality String?
  region      String?
  city        String?
  address     String?
  nationalId  String?

  program              String?
  programType          String?
  shortProgramDuration String?
  academicYear         String?
  semester             String?
  matricResult         String?
  ministryResult       String?

  profilePictureUrl String?
  faydaIdUrl        String?
  transcriptUrl     String?

  emergencyName         String?
  emergencyRelationship String?
  emergencyPhone        String?
  emergencyNotes        String?

  /// Department chosen on the /onboarding/about page (pre-enrollment preference).
  selectedDepartmentId  String?
  selectedDepartment    Department? @relation(fields: [selectedDepartmentId], references: [id])
  /// Set to true once the student confirms registration fee payment on /onboarding/about.
  registrationFeePaid   Boolean   @default(false)
  registrationFeePaidAt DateTime?
  /// Set to true once the student picks a department on /onboarding/about.
  departmentSelected    Boolean  @default(false)
  /// Set to true once a Finance Officer verifies the student's registration fee payment.
  paymentVerifiedByFinance   Boolean   @default(false)
  paymentVerifiedAt          DateTime?
  paymentVerifiedByUserId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// APPLICATION (legacy admissions form — extended with proper enum status)
// ─────────────────────────────────────────────────────────────────────────────

model Application {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName             String
  dob                  DateTime
  age                  Int
  gender               String
  nationality          String
  emergencyContact     String
  phone                String
  city                 String
  address              String
  program              String
  programType          String?
  shortProgramDuration String?
  academicYear         String
  semester             String
  studyMode            String

  status        ApplicationStatus @default(DRAFT)
  reviewComment String?
  reviewedBy    String?
  reviewedAt    DateTime?

  // ── Post-admission onboarding ─────────────────────────────────────────────
  onboardingStatus          OnboardingStatus @default(PENDING)
  registrationScreenshotUrl String?
  screenshotUploadedAt      DateTime?
  onboardingReviewedBy      String?
  onboardingReviewedAt      DateTime?
  onboardingRejectionReason String?

  documents   Document[]
  submittedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([program])
  @@index([academicYear])
}

model Document {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type       String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false)
  name      String?
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String   @db.VarChar(4000)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC FOUNDATION
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  code        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs        Program[]
  courses         Course[]
  instructors     InstructorRecord[]
  studentRecords  StudentRecord[]
  departmentHeads DepartmentHeadRecord[]
  onboardingStudents StudentProfile[]
  staffInvitations StaffInvitation[]

  @@index([code])
  @@index([isActive])
}

model Program {
  id            String  @id @default(uuid())
  name          String
  code          String  @unique
  description   String?
  durationYears Int     @default(4)
  totalCredits  Int     @default(120)
  isActive      Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses        ProgramCourse[]
  studentRecords StudentRecord[]
  requirements   ProgramRequirement[]

  @@index([departmentId])
  @@index([isActive])
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "2024-2025"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters      Semester[]
  calendarEvents AcademicCalendarEvent[]

  @@index([isCurrent])
}

model Semester {
  id             String       @id @default(uuid())
  name           String // "Semester I", "Semester II"
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  startDate         DateTime
  endDate           DateTime
  registrationStart DateTime
  registrationEnd   DateTime
  addDropDeadline   DateTime
  isCurrent         Boolean  @default(false)
  isActive          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings CourseOffering[]

  @@unique([academicYearId, name])
  @@index([isCurrent])
}

model Course {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  description String?
  creditHours Int          @default(3)
  status      CourseStatus @default(ACTIVE)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prerequisites  CoursePrerequisite[] @relation("CoursePrereqs")
  requiredBy     CoursePrerequisite[] @relation("PrereqFor")
  offerings      CourseOffering[]
  programCourses ProgramCourse[]

  @@index([code])
  @@index([departmentId])
  @@index([status])
}

model CoursePrerequisite {
  id             String @id @default(uuid())
  courseId       String
  course         Course @relation("CoursePrereqs", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteId String
  prerequisite   Course @relation("PrereqFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteId])
  @@index([courseId])
}

model ProgramCourse {
  id         String  @id @default(uuid())
  programId  String
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isRequired Boolean @default(true)
  yearLevel  Int     @default(1)

  @@unique([programId, courseId])
}

model ProgramRequirement {
  id              String  @id @default(uuid())
  programId       String
  program         Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  category        String // "CORE", "ELECTIVE", "GENERAL"
  description     String?
  requiredCredits Int
  minimumGPA      Float   @default(2.0)

  @@index([programId])
}

model Room {
  id       String   @id @default(uuid())
  name     String
  building String
  capacity Int
  roomType RoomType @default(CLASSROOM)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings     CourseOffering[]
  timetables    TimetableSlot[]
  classSessions ClassSession[]

  @@unique([building, name])
  @@index([building])
  @@index([isActive])
  @@index([roomType])
}

// ─────────────────────────────────────────────────────────────────────────────
// INSTRUCTORS
// ─────────────────────────────────────────────────────────────────────────────

model InstructorRecord {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId     String  @unique
  title          String  @default("Instructor")
  specialization String?
  isActive       Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings     CourseOffering[]
  timetables    TimetableSlot[]
  leaveRequests DepartmentLeaveRequest[]

  @@index([departmentId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT RECORDS (academic record, distinct from StudentProfile/auth)
// ─────────────────────────────────────────────────────────────────────────────

model StudentRecord {
  id        String        @id @default(uuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String        @unique // e.g. HC-2024-0012
  status    StudentStatus @default(ACTIVE)

  programId    String
  program      Program    @relation(fields: [programId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  yearLevel    Int      @default(1)
  gpa          Float    @default(0.0)
  totalCredits Int      @default(0)
  admittedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments            Enrollment[]
  transcriptRequests     TranscriptRequest[]
  graduationAudit        GraduationAudit?
  certificate            Certificate?
  courseGrades           CourseGrade[]
  assignmentSubmissions  AssignmentSubmission[]
  quizAttempts           QuizAttempt[]
  attendanceRecords      AttendanceRecord[]
  financialAccount       FinancialAccount?
  advisorAppointments    AdvisorAppointment[]
  notificationPreference StudentNotificationPreference?

  @@index([studentId])
  @@index([programId])
  @@index([departmentId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// COURSE OFFERINGS
// ─────────────────────────────────────────────────────────────────────────────

model CourseOffering {
  id         String         @id @default(uuid())
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id])
  semesterId String
  semester   Semester       @relation(fields: [semesterId], references: [id])
  status     OfferingStatus @default(DRAFT)

  instructorId String?
  instructor   InstructorRecord? @relation(fields: [instructorId], references: [id])

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  capacity Int    @default(40)
  section  String @default("A") // A, B, C for multiple sections

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments   Enrollment[]
  timetables    TimetableSlot[]
  assignments   Assignment[]
  quizzes       Quiz[]
  classSessions ClassSession[]

  @@unique([courseId, semesterId, section])
  @@index([semesterId])
  @@index([courseId])
  @@index([instructorId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────────────────────────────────────────

model TimetableSlot {
  id               String         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  dayOfWeek  Int                 // 0=Mon, 1=Tue, ..., 4=Fri
  startTime  String              // "09:00"
  endTime    String              // "10:30"
  status     TimetableSlotStatus @default(PUBLISHED)

  roomId       String?
  room         Room?             @relation(fields: [roomId], references: [id])
  instructorId String?
  instructor   InstructorRecord? @relation(fields: [instructorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseOfferingId])
  @@index([roomId])
  @@index([dayOfWeek])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ENROLLMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Enrollment {
  id               String           @id @default(uuid())
  studentRecordId  String
  studentRecord    StudentRecord    @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id])
  status           EnrollmentStatus @default(ACTIVE)

  enrolledAt DateTime  @default(now())
  droppedAt  DateTime?
  dropReason String?

  // Override fields (force-add/force-drop)
  isOverride     Boolean   @default(false)
  overrideReason String?
  overrideBy     String? // userId of registrar
  overrideAt     DateTime?

  grade CourseGrade?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentRecordId, courseOfferingId])
  @@index([studentRecordId])
  @@index([courseOfferingId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// GRADES
// ─────────────────────────────────────────────────────────────────────────────

model CourseGrade {
  id              String        @id @default(uuid())
  enrollmentId    String        @unique
  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentRecordId String
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id])

  letterGrade String? // A, B+, B, C+, C, D, F
  gradePoints Float? // 4.0, 3.5, 3.0, ...
  creditHours Int

  gradedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([studentRecordId])
  @@index([enrollmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRANSCRIPTS
// ─────────────────────────────────────────────────────────────────────────────

model TranscriptRequest {
  id              String                  @id @default(uuid())
  studentRecordId String
  studentRecord   StudentRecord           @relation(fields: [studentRecordId], references: [id])
  status          TranscriptRequestStatus @default(PENDING)
  purpose         String?
  requestedAt     DateTime                @default(now())
  processedAt     DateTime?
  processedBy     String?
  rejectionReason String?
  issuedAt        DateTime?
  documentUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentRecordId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// GRADUATION
// ─────────────────────────────────────────────────────────────────────────────

model GraduationAudit {
  id              String           @id @default(uuid())
  studentRecordId String           @unique
  studentRecord   StudentRecord    @relation(fields: [studentRecordId], references: [id])
  status          GraduationStatus @default(PENDING)

  completedCredits Int     @default(0)
  requiredCredits  Int     @default(120)
  currentGpa       Float   @default(0.0)
  requiredGpa      Float   @default(2.0)
  isEligible       Boolean @default(false)

  auditNotes  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  graduatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// CERTIFICATES
// ─────────────────────────────────────────────────────────────────────────────

model Certificate {
  id              String            @id @default(uuid())
  studentRecordId String            @unique
  studentRecord   StudentRecord     @relation(fields: [studentRecordId], references: [id])
  status          CertificateStatus @default(ISSUED)

  certificateNumber String   @unique
  verificationCode  String   @unique
  issuedAt          DateTime @default(now())
  issuedBy          String

  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?

  documentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationCode])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC CALENDAR
// ─────────────────────────────────────────────────────────────────────────────

model AcademicCalendarEvent {
  id             String            @id @default(uuid())
  title          String
  description    String?
  eventType      CalendarEventType
  startDate      DateTime
  endDate        DateTime
  isPublished    Boolean           @default(false)
  academicYearId String?
  academicYear   AcademicYear?     @relation(fields: [academicYearId], references: [id])

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType])
  @@index([startDate])
  @@index([isPublished])
}

// ─────────────────────────────────────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id             String             @id @default(uuid())
  title          String
  content        String             @db.Text
  status         AnnouncementStatus @default(DRAFT)
  priority       String             @default("NORMAL") // HIGH, NORMAL, LOW
  targetAudience String             @default("ALL") // ALL, DEPARTMENT:<id>, PROGRAM:<id>
  publishDate    DateTime?
  expirationDate DateTime?
  createdBy      String
  publishedBy    String?
  publishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// REGISTRAR AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model RegistrarAuditLog {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  action      RegistrarAction
  entityType  String // "Application", "StudentRecord", "Course", etc.
  entityId    String
  description String
  metadata    Json?
  ipAddress   String?         @db.VarChar(45)
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  /// INFO | SUCCESS | WARNING | ERROR | GRADE | SCHEDULE | ENROLLMENT | ANNOUNCEMENT | LEAVE | PAYROLL | FINANCE
  type       String   @default("INFO")
  isRead     Boolean  @default(false)
  entityType String?
  entityId   String?
  /// Optional deep-link tab name for the recipient's dashboard (e.g. "grades", "leave")
  actionTab  String?
  /// Timestamp when a socket push was attempted; null = not yet pushed
  pushedAt   DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
}

// ─────────────────────────────────────────────────────────────────────────────
// GRADE SCALE (registrar-managed, replaces hardcoded grade point map)
// ─────────────────────────────────────────────────────────────────────────────

model GradeScale {
  id           String  @id @default(uuid())
  letterGrade  String  @unique // "A", "A-", "B+", "B", etc.
  gradePoints  Float // 4.0, 3.7, 3.5, etc.
  description  String? // "Excellent", "Very Good", etc.
  isPassing    Boolean @default(true)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([letterGrade])
}

// ─────────────────────────────────────────────────────────────────────────────

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  ESSAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSessionLifecycle {
  NOT_STARTED
  OPEN
  CLOSED
  FINALIZED
}

enum AttendanceMethod {
  MANUAL
  QR
}

enum RoomType {
  CLASSROOM
  LAB
  LECTURE_HALL
  EXAM_HALL
  SEMINAR_ROOM
}

enum TimetableSlotStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TransactionType {
  TUITION
  FEE
  SCHOLARSHIP
  GRANT
  PAYMENT
  REFUND
  PENALTY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSIGNMENTS (instructor-created, linked to a CourseOffering)
// ─────────────────────────────────────────────────────────────────────────────

model Assignment {
  id               String         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  createdBy        String // instructorRecord.userId

  title           String
  description     String           @db.Text
  instructions    String           @db.Text
  dueDate         DateTime
  totalPoints     Int              @default(100)
  status          AssignmentStatus @default(DRAFT)
  allowLateSubmit Boolean          @default(false)
  maxFileSize     Int              @default(250) // MB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments AssignmentAttachment[]
  submissions AssignmentSubmission[]

  @@index([courseOfferingId])
  @@index([dueDate])
  @@index([status])
}

model AssignmentAttachment {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     String // human-readable e.g. "420 KB"
  fileType     String // "PDF", "TXT", etc.
  uploadedAt   DateTime   @default(now())

  @@index([assignmentId])
}

model AssignmentSubmission {
  id              String        @id @default(uuid())
  assignmentId    String
  assignment      Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentRecordId String
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  status      SubmissionStatus @default(SUBMITTED)
  submittedAt DateTime         @default(now())

  // Submission content
  fileUrl     String?
  fileName    String?
  fileSize    String?
  textContent String? @db.Text

  // Grading
  score       Float?
  letterGrade String?
  feedback    String?   @db.Text
  gradedAt    DateTime?
  gradedBy    String? // instructorRecord.userId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentRecordId])
  @@index([assignmentId])
  @@index([studentRecordId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUIZZES
// ─────────────────────────────────────────────────────────────────────────────

model Quiz {
  id               String         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  createdBy        String // instructorRecord.userId

  title                  String
  description            String?
  instructions           String?    @db.Text
  durationMinutes        Int        @default(30)
  availableFrom          DateTime
  availableUntil         DateTime
  passingScore           Int        @default(60) // percentage
  maxAttempts            Int        @default(1)
  totalPoints            Int        @default(100)
  showResultsImmediately Boolean    @default(true)
  status                 QuizStatus @default(DRAFT)
  shuffleQuestions       Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseOfferingId])
  @@index([status])
  @@index([availableFrom])
  @@index([availableUntil])
}

model QuizQuestion {
  id           String       @id @default(uuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String       @db.Text
  type         QuestionType
  points       Int          @default(1)
  orderIndex   Int          @default(0)

  options QuizQuestionOption[]
  answers QuizAnswer[]

  @@index([quizId])
  @@index([orderIndex])
}

model QuizQuestionOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  orderIndex Int          @default(0)

  @@index([questionId])
}

model QuizAttempt {
  id              String        @id @default(uuid())
  quizId          String
  quiz            Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentRecordId String
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  status           QuizAttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime          @default(now())
  submittedAt      DateTime?
  timeSpentSeconds Int?

  score           Float?
  percentageScore Float?
  isPassing       Boolean?
  feedback        String?   @db.Text
  gradedAt        DateTime?
  gradedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers QuizAnswer[]

  @@index([quizId])
  @@index([studentRecordId])
  @@index([status])
}

model QuizAnswer {
  id         String       @id @default(uuid())
  attemptId  String
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerText       String? @db.Text // for open-ended
  selectedOptionId String? // for MCQ / TrueFalse

  isCorrect    Boolean?
  pointsEarned Float?

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE (full spec per attendance.md)
// ─────────────────────────────────────────────────────────────────────────────

/// A specific physical class meeting derived from a TimetableSlot.
model ClassSession {
  id               String         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  date      DateTime // The actual calendar date of this session
  startTime String // "09:00"
  endTime   String // "10:30"
  topic     String?
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())

  attendanceSession AttendanceSession?

  @@unique([courseOfferingId, date, startTime])
  @@index([courseOfferingId])
  @@index([date])
}

/// The attendance-taking period for a ClassSession.
/// Lifecycle: NOT_STARTED → OPEN → CLOSED → FINALIZED
model AttendanceSession {
  id             String                     @id @default(uuid())
  classSessionId String                     @unique
  classSession   ClassSession               @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  openedBy       String // InstructorRecord.userId
  lifecycle      AttendanceSessionLifecycle @default(NOT_STARTED)

  openedAt    DateTime?
  closedAt    DateTime?
  finalizedAt DateTime?

  // QR attendance token (hashed — raw token sent to frontend only once)
  qrTokenHash   String?
  qrTokenExpiry DateTime?

  // Policy overrides for this session
  openBeforeMinutes Int @default(15)   // how early attendance can open before class start
  lateAfterMinutes  Int @default(10)
  closeAfterMinutes Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records AttendanceRecord[]

  @@index([openedBy])
  @@index([lifecycle])
}

/// One student's attendance for one AttendanceSession.
model AttendanceRecord {
  id                  String            @id @default(uuid())
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentRecordId     String
  studentRecord       StudentRecord     @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  status   AttendanceStatus @default(PRESENT)
  method   AttendanceMethod @default(MANUAL)
  markedAt DateTime         @default(now())
  markedBy String // userId who marked (instructor or student via QR)
  note     String?

  // Correction tracking
  correctionOf     String? // ID of previous record this corrects
  correctionReason String?
  correctedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corrections AttendanceCorrectionLog[]

  @@unique([attendanceSessionId, studentRecordId])
  @@index([attendanceSessionId])
  @@index([studentRecordId])
}

/// Append-only audit log for attendance corrections.
model AttendanceCorrectionLog {
  id                 String           @id @default(uuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  oldStatus AttendanceStatus
  newStatus AttendanceStatus
  reason    String
  changedBy String // userId
  changedAt DateTime         @default(now())

  @@index([attendanceRecordId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCIALS
// ─────────────────────────────────────────────────────────────────────────────

model FinancialAccount {
  id              String        @id @default(uuid())
  studentRecordId String        @unique
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  balance        Float    @default(0.0) // 0 = cleared
  clearedForTerm String? // e.g. "Fall 2024"
  lastUpdatedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinancialTransaction[]

  @@index([studentRecordId])
}

model FinancialTransaction {
  id                 String           @id @default(uuid())
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  type        TransactionType
  amount      Float // positive = charge, negative = credit
  description String
  category    String // "Tuition", "Fee", "Scholarship", etc.
  receiptId   String?         @unique
  status      String          @default("POSTED") // POSTED, PENDING, REVERSED
  referenceId String? // payment gateway reference

  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([financialAccountId])
  @@index([transactionDate])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// ADVISOR APPOINTMENTS
// ─────────────────────────────────────────────────────────────────────────────

model AdvisorAppointment {
  id              String        @id @default(uuid())
  studentRecordId String
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)
  advisorUserId   String // instructor userId acting as advisor

  topic         String
  requestedDate DateTime
  requestedTime String // "10:00", "11:30", etc.
  status        AppointmentStatus @default(PENDING)

  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  meetingLink        String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentRecordId])
  @@index([advisorUserId])
  @@index([status])
  @@index([requestedDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT NOTIFICATION PREFERENCES
// ─────────────────────────────────────────────────────────────────────────────

model StudentNotificationPreference {
  id              String        @id @default(uuid())
  studentRecordId String        @unique
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  gradeAlerts      Boolean @default(true)
  tuitionReminders Boolean @default(true)
  registrarNotices Boolean @default(true)
  advisorMessages  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// DEPARTMENT HEAD RECORD
// Links a DEPARTMENT_HEAD user to their assigned department.
// ─────────────────────────────────────────────────────────────────────────────

model DepartmentHeadRecord {
  id         String  @id @default(uuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId String  @unique
  title      String  @default("Department Head")
  isActive   Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests DepartmentLeaveRequest[]

  @@index([departmentId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAVE REQUEST (Faculty → Department Head → HR)
// ─────────────────────────────────────────────────────────────────────────────

enum LeaveType {
  MEDICAL
  PERSONAL
  CONFERENCE
  RESEARCH
  ANNUAL
  MATERNITY
  PATERNITY
  EMERGENCY
}

enum LeaveStatus {
  PENDING_DH // Awaiting Department Head review
  DH_APPROVED // Approved by DH, forwarded to HR
  DH_REJECTED // Rejected by DH (final)
  HR_APPROVED // HR final approval
  HR_REJECTED // HR final rejection
  WITHDRAWN // Faculty withdrew
}

model DepartmentLeaveRequest {
  id           String           @id @default(uuid())
  /// Faculty member submitting the request
  instructorId String
  instructor   InstructorRecord @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  leaveType        LeaveType
  startDate        DateTime
  endDate          DateTime
  durationDays     Int
  reason           String    @db.Text
  supportingDocUrl String? // Uploaded file URL

  status LeaveStatus @default(PENDING_DH)

  /// Department Head who reviewed this request
  reviewedByDhId String?
  reviewedByDh   DepartmentHeadRecord? @relation(fields: [reviewedByDhId], references: [id])
  dhComment      String?               @db.Text
  dhReviewedAt   DateTime?

  /// HR final decision
  hrComment    String?   @db.Text
  hrReviewedAt DateTime?
  hrReviewedBy String? // userId of HR officer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
  @@index([status])
  @@index([startDate])
  @@index([reviewedByDhId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DEPARTMENT HEAD AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

enum DepartmentHeadAction {
  OFFERING_APPROVED
  OFFERING_REJECTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  PROFILE_UPDATED
  PASSWORD_CHANGED
}

model DepartmentHeadAuditLog {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  action      DepartmentHeadAction
  entityType  String // "CourseOffering", "LeaveRequest", etc.
  entityId    String
  description String
  metadata    Json?
  ipAddress   String?              @db.VarChar(45)
  createdAt   DateTime             @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// HR MODULE ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum HREmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum HRContractStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  PROBATION
}

enum HREmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum HRGender {
  MALE
  FEMALE
}

enum HRLeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  EMERGENCY
  STUDY
}

enum HRLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  FORWARDED
  CANCELLED
}

enum HRApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HRPayrollStage {
  DRAFT
  PENDING_REVIEW
  PENDING_HR_APPROVAL
  APPROVED
  LOCKED
}

enum HRReviewCycle {
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum HRReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum HRDocumentCategory {
  CV
  CONTRACT
  NATIONAL_ID
  CERTIFICATE
  PERFORMANCE_REPORT
  PAYSLIP
  LEAVE_DOCUMENT
}

enum HROnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum HROffboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum HRExitReason {
  RESIGNATION
  TERMINATION
  CONTRACT_EXPIRY
  RETIREMENT
}

enum HRAuditStatus {
  SUCCESS
  WARNING
  FAILED
}

enum HRNotifType {
  LEAVE
  PAYROLL
  PERFORMANCE
  CONTRACT
  ONBOARDING
  SYSTEM
}

// ─────────────────────────────────────────────────────────────────────────────
// HR MODELS
// ─────────────────────────────────────────────────────────────────────────────

/// An HR department (separate from the academic Department model)
model HRDepartment {
  id             String   @id @default(uuid())
  name           String   @unique
  headEmployeeId String?
  budget         Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employees      HREmployee[]

  @@index([isActive])
}

/// HR employee record — includes personal, employment, salary, and sensitive fields
model HREmployee {
  id               String            @id @default(uuid())
  employeeCode     String            @unique   // e.g. HC-FAC-0042
  userId           String?           @unique   // linked User if they have a login
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Personal
  fullName         String
  avatarUrl        String?
  gender           HRGender
  dateOfBirth      DateTime?
  address          String?

  // Contact
  email            String            @unique
  phone            String?

  // Employment
  departmentId     String
  department       HRDepartment      @relation(fields: [departmentId], references: [id])
  position         String
  employmentType   HREmploymentType  @default(FULL_TIME)
  contractStatus   HRContractStatus  @default(ACTIVE)
  status           HREmployeeStatus  @default(ACTIVE)
  hireDate         DateTime
  contractEndDate  DateTime?
  managerId        String?
  manager          HREmployee?       @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates     HREmployee[]      @relation("EmployeeManager")

  // Qualifications
  education        String?
  experienceYears  Int               @default(0)

  // Salary — stored encrypted conceptually; kept in DB for payroll generation
  basicSalary      Float             @default(0)
  allowances       Float             @default(0)
  deductions       Float             @default(0)

  // Sensitive (masked in frontend)
  nationalId       String?
  bankAccount      String?
  taxNumber        String?

  // Ethiopian national Fayda ID document
  faydaIdUrl       String?
  faydaIdFileSize  String?

  // Academic credential certificate
  certificateUrl     String?
  certificateFileSize String?

  // System role this employee will hold (links to the platform Role enum)
  // Allowed for HR creation: INSTRUCTOR, DEPARTMENT_HEAD, REGISTRAR, FINANCE_OFFICER, HR_OFFICER
  systemRole       String?   // mirrors Role enum value — enforced at service layer

  // Course assignment (required when systemRole = INSTRUCTOR or DEPARTMENT_HEAD)
  courseId         String?   // FK to the academic Course — optional, enforced conditionally

  // Emergency contact
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  leaveRequests    HRLeaveRequest[]
  leaveBalances    HRLeaveBalance[]
  payslips         HRPayslip[]
  performanceReviews HRPerformanceReview[]
  documents        HRDocument[]
  onboardingRecord HROnboardingRecord?
  offboardingRecord HROffboardingRecord?
  notifications    HRNotification[]
  salaryHistory    HRSalaryHistory[]
  contractRenewals HRContractRenewal[]

  @@index([status])
  @@index([departmentId])
  @@index([contractStatus])
  @@index([employmentType])
  @@index([isActive])
  @@index([systemRole])
}

/// Leave request raised by an employee
model HRLeaveRequest {
  id             String           @id @default(uuid())
  employeeId     String
  employee       HREmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      HRLeaveType
  startDate      DateTime
  endDate        DateTime
  daysCount      Int
  reason         String           @db.Text
  status         HRLeaveStatus    @default(PENDING)
  managerApproval HRApprovalStatus @default(PENDING)
  hrApproval     HRApprovalStatus  @default(PENDING)
  reviewComment  String?
  reviewedByUserId String?
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([leaveType])
  @@index([startDate])
}

/// Running leave balance per employee per type
model HRLeaveBalance {
  id           String     @id @default(uuid())
  employeeId   String
  employee     HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    HRLeaveType
  entitled     Int        @default(0)
  taken        Int        @default(0)
  remaining    Int        @default(0)
  year         Int        // calendar year

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
}

/// Monthly payroll batch
model HRPayrollRecord {
  id             String         @id @default(uuid())
  month          String         // "July"
  year           Int
  stage          HRPayrollStage @default(DRAFT)
  totalGross     Float          @default(0)
  totalNet       Float          @default(0)
  employeeCount  Int            @default(0)
  generatedAt    DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  approvals      HRPayrollApproval[]
  payslips       HRPayslip[]

  @@unique([month, year])
  @@index([stage])
  @@index([year])
}

/// Individual payroll approval step
model HRPayrollApproval {
  id          String          @id @default(uuid())
  payrollId   String
  payroll     HRPayrollRecord @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  stageName   String
  approverName String
  approvedAt  DateTime?
  status      HRApprovalStatus @default(PENDING)
  comment     String?
  createdAt   DateTime        @default(now())

  @@index([payrollId])
}

/// Individual employee payslip in a payroll batch
model HRPayslip {
  id               String          @id @default(uuid())
  payrollId        String
  payroll          HRPayrollRecord @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         HREmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basicSalary      Float
  allowances       Float           @default(0)
  bonuses          Float           @default(0)
  tax              Float           @default(0)
  pension          Float           @default(0)
  otherDeductions  Float           @default(0)
  netSalary        Float
  createdAt        DateTime        @default(now())

  @@unique([payrollId, employeeId])
  @@index([payrollId])
  @@index([employeeId])
}

/// Semi-annual / quarterly / annual performance review
model HRPerformanceReview {
  id              String          @id @default(uuid())
  employeeId      String
  employee        HREmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle           HRReviewCycle
  period          String          // "H1 2024", "Q2 2024", "2024"
  status          HRReviewStatus  @default(PENDING)
  dueDate         DateTime
  overallScore    Float?
  goalsScore      Float?
  competenciesScore Float?
  attendanceScore Float?
  communicationScore Float?
  leadershipScore Float?
  technicalScore  Float?
  managerComment  String?         @db.Text
  hrComment       String?         @db.Text
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([dueDate])
}

/// Documents linked to an employee
model HRDocument {
  id           String              @id @default(uuid())
  employeeId   String
  employee     HREmployee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category     HRDocumentCategory
  title        String
  fileUrl      String?
  fileSize     String?
  uploadedByUserId String?
  uploadedByName   String?
  version      Int                 @default(1)
  uploadedAt   DateTime            @default(now())
  createdAt    DateTime            @default(now())

  @@index([employeeId])
  @@index([category])
}

/// Onboarding checklist for a new hire
model HROnboardingRecord {
  id           String             @id @default(uuid())
  employeeId   String             @unique
  employee     HREmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  currentStep  Int                @default(0)
  status       HROnboardingStatus @default(NOT_STARTED)
  startedAt    DateTime           @default(now())
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  steps        HROnboardingStep[]
}

model HROnboardingStep {
  id           String             @id @default(uuid())
  recordId     String
  record       HROnboardingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  stepKey      String             // "personal_info", "contract", etc.
  label        String
  completed    Boolean            @default(false)
  orderIndex   Int

  @@unique([recordId, stepKey])
  @@index([recordId])
}

/// Offboarding record for a departing employee
model HROffboardingRecord {
  id               String              @id @default(uuid())
  employeeId       String              @unique
  employee         HREmployee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lastWorkingDay   DateTime
  exitReason       HRExitReason
  currentStep      Int                 @default(0)
  status           HROffboardingStatus @default(NOT_STARTED)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  assetChecklist   HRAssetCheckItem[]
}

model HRAssetCheckItem {
  id           String              @id @default(uuid())
  recordId     String
  record       HROffboardingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  item         String
  returned     Boolean             @default(false)
  notes        String?

  @@index([recordId])
}

/// Append-only HR audit log
model HRAuditLog {
  id           String        @id @default(uuid())
  actorUserId  String?
  actorName    String
  action       String
  employeeName String        @default("All Staff")
  module       String
  description  String        @db.Text
  status       HRAuditStatus @default(SUCCESS)
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([actorUserId])
  @@index([module])
  @@index([createdAt])
  @@index([status])
}

/// HR in-app notification
model HRNotification {
  id          String      @id @default(uuid())
  employeeId  String?
  employee    HREmployee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recipientUserId String  // the HR officer's userId who receives this
  type        HRNotifType
  title       String
  message     String      @db.Text
  tab         String      // matches HRNavTab
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([recipientUserId])
  @@index([isRead])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// SALARY HISTORY (recommendation §1 — never lose previous salary when updated)
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only salary change record. Created every time an employee's salary is updated.
model HRSalaryHistory {
  id           String     @id @default(uuid())
  employeeId   String
  employee     HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  effectiveDate  DateTime
  basicSalary    Float
  allowances     Float    @default(0)
  deductions     Float    @default(0)
  grossSalary    Float    // basicSalary + allowances (computed at write time)

  reason         String?  @db.Text   // "Annual increment", "Promotion", etc.
  changedByUserId String?
  changedByName   String

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([effectiveDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTRACT RENEWAL (recommendation §2)
// ─────────────────────────────────────────────────────────────────────────────

/// A contract renewal record created when HR renews or extends an employee contract.
model HRContractRenewal {
  id           String     @id @default(uuid())
  employeeId   String
  employee     HREmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  previousEndDate  DateTime
  newEndDate       DateTime
  reason           String?  @db.Text
  documentId       String?  // optional linked HRDocument id

  approvedByUserId String?
  approvedByName   String
  approvedAt       DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([employeeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// STAFF INVITATION (Admin Provisioning)
// ─────────────────────────────────────────────────────────────────────────────

model StaffInvitation {
  id                 String     @id @default(uuid())
  email              String
  fullName           String
  role               Role
  departmentId       String
  department         Department @relation(fields: [departmentId], references: [id])
  positionTitle      String?
  employeeId         String?
  phone              String?
  specialization     String?
  tokenHash          String     @unique
  expiresAt          DateTime
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  invitedByUserId    String
  invitedByUser      User       @relation("SentInvitations", fields: [invitedByUserId], references: [id])

  acceptedByUserId   String?    @unique
  acceptedByUser     User?      @relation("AcceptedInvitation", fields: [acceptedByUserId], references: [id])

  @@index([email])
  @@index([tokenHash])
  @@index([invitedByUserId])
  @@index([departmentId])
  @@index([role])
  @@index([expiresAt])
}
