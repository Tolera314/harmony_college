# ─────────────────────────────────────────────────────────────────────────────
# Harmony College — Backend Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ── JWT / Sessions ────────────────────────────────────────────────────────────
# REQUIRED — at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-cryptographically-random-secret-at-least-32-chars"

# Access token lifetime (jose duration string: 15m, 1h, etc.)  Default: 15m
ACCESS_TOKEN_EXPIRES_IN="15m"

# Refresh token lifetime  Default: 30d
REFRESH_TOKEN_EXPIRES_IN="30d"

# Session inactivity timeout in MINUTES.  Default: 30
SESSION_INACTIVITY_TIMEOUT="30"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"

# ── Verification / Messaging providers ───────────────────────────────────────
# SMS_PROVIDER: "console" (default/dev) | "afromessage" | "geez"
SMS_PROVIDER="console"
AFROMESSAGE_API_KEY=""
AFROMESSAGE_SENDER_ID="HarmonyHC"
GEEZSMS_API_KEY=""
GEEZSMS_SENDER="HarmonyHC"

# EMAIL_PROVIDER: "console" (default/dev) | "resend" | "sendgrid"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@harmonycollege.edu.et"
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@harmonycollege.edu.et"


# ── Runtime ───────────────────────────────────────────────────────────────────
# "development" | "production" | "test"
NODE_ENV="development"

# ── Phase 6 — Password Reset ──────────────────────────────────────────────────
# Reset token lifetime in SECONDS. Default: 900 (15 minutes)
RESET_TOKEN_TTL="900"

