# ─────────────────────────────────────────────────────────────────────────────
# Harmony College — Backend Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/harmony_college"

# ── JWT / Sessions ────────────────────────────────────────────────────────────
# REQUIRED — at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-cryptographically-random-secret-at-least-32-chars"

# ── Groq AI (chatbot) ─────────────────────────────────────────────────────────
# Used by POST /api/ai/chat — never exposed to the browser.
# Get yours free at https://console.groq.com
GROQ_API_KEY="your-groq-api-key-here"

# Access token lifetime (jose duration string: 15m, 1h, etc.)  Default: 15m
ACCESS_TOKEN_EXPIRES_IN="1h"

# Refresh token lifetime. Default: 30d
REFRESH_TOKEN_EXPIRES_IN="30d"

# Session inactivity timeout in MINUTES. Default: 30
SESSION_INACTIVITY_TIMEOUT="30"

# Password reset token lifetime in SECONDS. Default: 900 (15 min)
RESET_TOKEN_TTL="900"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# ── CORS & App URLs ───────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# ── File uploads ──────────────────────────────────────────────────────────────
# Local directory for uploaded files (relative to backend root)
UPLOAD_DIR="uploads"

# ── Cloudinary (Profile Photo Storage) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_FOLDER="harmony_college/profiles"

# ── Verification / Messaging providers ───────────────────────────────────────
# SMS_PROVIDER: "console" (default/dev) | "afromessage" | "geez"
SMS_PROVIDER="console"
AFROMESSAGE_API_KEY=""
AFROMESSAGE_SENDER_ID="HarmonyHC"
GEEZSMS_API_KEY=""
GEEZSMS_SENDER="HarmonyHC"

# EMAIL_PROVIDER: "console" (default/dev) | "resend" | "sendgrid"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@harmonycollege.edu.et"

# ── OAuth — Google ────────────────────────────────────────────────────────────
# Get credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/google/callback"

# ── OAuth — Facebook ──────────────────────────────────────────────────────────
# Get credentials at https://developers.facebook.com/apps
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/oauth/facebook/callback"
