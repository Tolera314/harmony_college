# ─────────────────────────────────────────────────────────────────────────────
# Harmony College — Backend Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ── JWT / Sessions ────────────────────────────────────────────────────────────
# REQUIRED — at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-cryptographically-random-secret-at-least-32-chars"

# Access token lifetime (jose duration string: 15m, 1h, etc.)  Default: 15m
ACCESS_TOKEN_EXPIRES_IN="15m"

# Refresh token lifetime  Default: 30d
REFRESH_TOKEN_EXPIRES_IN="30d"

# Session inactivity timeout in MINUTES.  Default: 30
SESSION_INACTIVITY_TIMEOUT="30"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"

# ── Verification / Messaging providers ───────────────────────────────────────
# SMS_PROVIDER: "console" (default/dev) | "afromessage" | "geez"
SMS_PROVIDER="console"
AFROMESSAGE_API_KEY=""
AFROMESSAGE_SENDER_ID="HarmonyHC"
GEEZSMS_API_KEY=""
GEEZSMS_SENDER="HarmonyHC"

# EMAIL_PROVIDER: "console" (default/dev) | "resend" | "sendgrid"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@harmonycollege.edu.et"
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@harmonycollege.edu.et"


# ── Runtime ───────────────────────────────────────────────────────────────────
# ── Phase 8 — OAuth / OpenID Connect Authentication ──────────────────────────
# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/google/callback"

# ── Facebook Login (OAuth 2.0) ────────────────────────────────────────────────
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/oauth/facebook/callback"


