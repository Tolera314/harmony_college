# ─────────────────────────────────────────────────────────────────────────────
# Harmony College — Frontend Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Backend proxy URL (Next.js rewrites /api/* → this host)
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Socket.IO direct URL (ChatPanel, ChatView, SocketContext)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# JWT Secret — Next.js middleware (server-side only, never sent to browser)
# Must match backend/.env JWT_SECRET exactly.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-same-value-as-backend-JWT_SECRET"

# NOTE: GROQ_API_KEY belongs in backend/.env only.
# The AI chat route (app/api/ai/chat/route.ts) now proxies to the Express
# backend which holds the key. Do NOT add GROQ_API_KEY here.
